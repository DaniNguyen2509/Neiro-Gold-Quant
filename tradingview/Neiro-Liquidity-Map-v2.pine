//@version=6
// =====================================================================
//  NEIRO LIQUIDITY MAP  v2   -   GTRADER EDITION
//  Every level = one horizontal line drawn from the candle that created it,
//  extended to the right, with a price label. Sessions, daily / weekly
//  extremes, equal highs & lows, intraday pivots and swept-liquidity memory.
//
//  BAN SONG SONG cua Neiro-Liquidity-Map.pine. Khac dung hai diem:
//    1. THEM lop ICT MACROS port tu "GTrader-ICT All In One - Comumnity
//       Version" - 5 cua so macro, vach tren + vach duoi + nhan.
//       va DUNG LAI lop Projection Candles theo "cau tao nen" cua ban goc:
//         than / vien / rau ba mau rieng, khoang cach giua cac cum khung,
//         cho dat + can nhan, dem nguoc, moc ngay, nhan gia, vach trace.
//       File goc: tradingview/vendor/Gtrader-ICT.txt  (CHI DOC).
//    2. BO HAN lop Premium & Discount (PD array) cua ban 1.0 - ca ba box
//       premium / equilibrium / discount lan hang RANGE tren dashboard.
//
//  Lop KILLZONES cua GTrader tung nam o day, da GO 22-08 theo owner: box to
//  mau bao range phien khong khac gi lop "Session Ranges" san co cua Neiro -
//  ca hai deu chi la khung cao-thap cua phien, khong co than / rau gi de phan
//  biet. Muon lay lai: git show <commit truoc do>:tradingview/Neiro-Liquidity-Map-v2.pine
//
//  All time anchors use America/New_York (auto DST). No orders are placed.
// =====================================================================
indicator("Neiro Liquidity Map", "Neiro LM", overlay = true, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500)

// Hien tren dashboard. Nguoi mua bao loi thi doc duoc ngay dang chay ban nao.
NL_VER = "2.0"

TZ = "America/New_York"

// =====================================================================
//  GENERAL
// =====================================================================
gGen = "General"
preset = input.string("Custom", "Preset (overrides the switches)", options = ["Custom", "Minimal", "Day Trading", "Full ICT"], group = gGen, tooltip = "Custom - every layer follows its own checkbox below.\nMinimal - only the levels price reacts to most: ATH, PDH/PDL, HOD/LOD and the live session.\nDay Trading - adds previous week, current week, midnight open, previous sessions and equal highs/lows.\nFull ICT - everything, including H1 and M15 pivots.\n\nA preset OVERRIDES the checkboxes. Switch back to Custom to use them again.")
eqDays = input.int(10, "History depth (days)", minval = 1, maxval = 30, group = gGen, tooltip = "How far back the indicator looks for sessions, equal highs/lows and intraday pivots. Larger = more levels on screen, not more accuracy.")
scaleMode = input.string("Volatility (ATR)", "Scale thresholds to symbol", options = ["Price", "Volatility (ATR)", "Off (gold dollars)"], group = gGen, tooltip = "Every dollar threshold in this indicator was tuned on gold. On EURUSD a 1.5 dollar merge gap swallows the whole price range; on BTC it merges nothing. This rescales them for whatever symbol the chart is on.\n\nVolatility (ATR) - scales by how far the symbol actually moves in a day, using a 200 period ATR on the daily timeframe. This is the dimensionally correct unit and it is the only mode that is right on forex, where the daily range is small relative to the price level. Measured over 460 days of gold it held a 1.8x band and moved 0.31% a day.\n\nPrice - scales by price level only. Over the same 460 days it held a 1.9x band and moved 0.98% a day, so it is marginally less steady than the ATR mode and it does not know about volatility at all: on forex majors it merges roughly three times more aggressively than it does on gold.\n\nOff - takes the numbers literally. Correct on gold, wrong everywhere else.\n\nCalibrated so that on gold the factor is 1.00 - the defaults behave the same under any mode.")
dayTZsel = input.string("New York (ICT)", "Day boundary", options = ["New York (ICT)", "Broker / EET (GMT+2, +3 summer)", "London", "UTC", "Tokyo", "Sydney"], group = gGen, tooltip = "Where the trading DAY is cut. Everything dated by day follows this: previous day high/low, two days ago, today high/low, the midnight open line, the daily projection candle, and the rule that drops a swept previous-week level at the next midnight.\n\nBroker / EET is the default to match standard forex daily candles. Pick New York if you follow the strict ICT convention of midnight NY time.\n\nThe five SESSION windows are NOT affected. London opens when London opens, whatever clock your broker keeps - so their times stay on New York and you do not have to re-enter ten fields.")
dayTZ = dayTZsel == "Broker / EET (GMT+2, +3 summer)" ? "Europe/Athens" : dayTZsel == "London" ? "Europe/London" : dayTZsel == "UTC" ? "UTC" : dayTZsel == "Tokyo" ? "Asia/Tokyo" : dayTZsel == "Sydney" ? "Australia/Sydney" : "America/New_York"
dayHour = input.int(0, "Day starts at (hour)", minval = 0, maxval = 23, group = gGen, tooltip = "The hour the day flips over, inside the zone chosen above. 0 = midnight, the ICT convention.\n\nSet New York + 17 for the classic forex day: 17:00 New York is the rollover, which is where most brokers open their daily candle. Broker / EET + 0 lands on the same instant most of the year and is the simpler way to say it.\n\nIt moves the whole day-based set together - previous day, two days ago, today, the open line and the daily projection candle - so they always agree with each other.")

// =====================================================================
//  DAILY & WEEKLY LEVELS   -   one row per layer: [on] name | colour | line
// =====================================================================
gDW = "Daily & Weekly Levels"
showATH = input.bool(true, "", inline = "ath", group = gDW)
athC    = input.color(#FFD700, "All-Time High", inline = "ath", group = gDW)
athS    = input.string("Solid", "", options = ["Solid", "Dashed", "Dotted"], inline = "ath", group = gDW)

showPW = input.bool(true, "", inline = "pw", group = gDW)
pwC    = input.color(#9575CD, "Previous Week H/L", inline = "pw", group = gDW)
pwS    = input.string("Dashed", "", options = ["Solid", "Dashed", "Dotted"], inline = "pw", group = gDW, tooltip = "Once PWH or PWL is swept it stays visible in grey only until the next day boundary, then it is dropped for good. The day boundary is the one set at the top, so this follows your clock, not New York, if you changed it.")

showHOW = input.bool(true, "", inline = "how", group = gDW)
wkC     = input.color(#5C6BC0, "Current Week H/L", inline = "how", group = gDW)
wkS     = input.string("Solid", "", options = ["Solid", "Dashed", "Dotted"], inline = "how", group = gDW)

showPD = input.bool(true, "", inline = "pd", group = gDW)
pdC    = input.color(#FFC107, "Previous Day H/L", inline = "pd", group = gDW)
pdS    = input.string("Dashed", "", options = ["Solid", "Dashed", "Dotted"], inline = "pd", group = gDW)

showBPD = input.bool(false, "", inline = "bpd", group = gDW)
bpdC    = input.color(#FFE082, "Two Days Ago H/L", inline = "bpd", group = gDW)
bpdS    = input.string("Dashed", "", options = ["Solid", "Dashed", "Dotted"], inline = "bpd", group = gDW)

showDay = input.bool(true, "", inline = "day", group = gDW)
dayC    = input.color(#26C6DA, "Today H/L", inline = "day", group = gDW)
dayS    = input.string("Solid", "", options = ["Solid", "Dashed", "Dotted"], inline = "day", group = gDW)

showMNO = input.bool(true, "", inline = "mno", group = gDW)
mnoC    = input.color(color.gray, "Midnight Open", inline = "mno", group = gDW)
mnoS    = input.string("Dashed", "", options = ["Solid", "Dashed", "Dotted"], inline = "mno", group = gDW, tooltip = "Opening price of the first candle of the day, as cut by the Day boundary and Day starts at settings - the ICT reference for intraday premium / discount. Left on New York at hour 0 this is the classic midnight open, which is what MNO stands for.")

// =====================================================================
//  SESSION LEVELS   -   one row per session: [on] name | live | previous
// =====================================================================
gSes = "Session Levels"
showTokyo = input.bool(true, "", inline = "tk", group = gSes)
sTokyo    = input.session("0000-0200", "Tokyo", inline = "tk", group = gSes, tooltip = "Window in New York time. The first colour is the session running now, the second is every earlier session of the same name inside the history window.")
tkC       = input.color(#FF9800, "", inline = "tk", group = gSes)
btkC      = input.color(#FFCC80, "", inline = "tk", group = gSes)

showLondon = input.bool(true, "", inline = "lo", group = gSes)
sLondon    = input.session("0200-0930", "London", inline = "lo", group = gSes, tooltip = "Window in New York time. The first colour is the session running now, the second is every earlier session of the same name inside the history window.")
loC        = input.color(#2962FF, "", inline = "lo", group = gSes)
bloC       = input.color(#90CAF9, "", inline = "lo", group = gSes)

showNyAm = input.bool(true, "", inline = "am", group = gSes)
sNyAm    = input.session("0930-1100", "NY AM", inline = "am", group = gSes, tooltip = "Window in New York time. The first colour is the session running now, the second is every earlier session of the same name inside the history window.")
amC      = input.color(#E53935, "", inline = "am", group = gSes)
bamC     = input.color(#EF9A9A, "", inline = "am", group = gSes)

showLunch = input.bool(false, "", inline = "lu", group = gSes)
sLunch    = input.session("1100-1300", "NY Lunch", inline = "lu", group = gSes, tooltip = "Window in New York time. The first colour is the session running now, the second is every earlier session of the same name inside the history window.\n\n11:00 to 13:00 - the lull that starts as the AM session winds down and runs to the PM open. Its high and low are worth having precisely because volume drains out of it: the range is narrow, and the move that leaves it is usually the one that matters.")
luC       = input.color(#8D6E63, "", inline = "lu", group = gSes)
bluC      = input.color(#BCAAA4, "", inline = "lu", group = gSes)

showNyPm = input.bool(true, "", inline = "pm", group = gSes)
sNyPm    = input.session("1330-1600", "NY PM", inline = "pm", group = gSes, tooltip = "Window in New York time. The first colour is the session running now, the second is every earlier session of the same name inside the history window.")
pmC      = input.color(#8E24AA, "", inline = "pm", group = gSes)
bpmC     = input.color(#CE93D8, "", inline = "pm", group = gSes)

showPrevSess = input.bool(true, "Show earlier sessions", group = gSes, tooltip = "Every completed session inside the history window keeps its own high and low. They carry a p prefix - pLondon-H is the high of an earlier London session.")
sessS        = input.string("Solid", "Live session line", options = ["Solid", "Dashed", "Dotted"], inline = "ss", group = gSes)
bsessS       = input.string("Dashed", "Previous", options = ["Solid", "Dashed", "Dotted"], inline = "ss", group = gSes)

// =====================================================================
//  SESSION RANGES (boxes)
// =====================================================================
gZ = "Session Ranges"
showSessZoneIn = input.bool(true, "Draw session range box", group = gZ, tooltip = "Master switch for the range boxes - the rectangle drawn around the high and low of a session.\n\nBorder and Fill right below decide what a box looks like; the five rows under them decide which sessions get one and in what colour. A box needs at least one of Border or Fill on to be visible.\n\nThe session HIGH and LOW lines are a different layer with its own switches in Session Levels.")
// 23-08: hai cong tac cua CA LOP, dat ngay duoi cong tac tong. Truoc do chung nam
// duoi cung nhom, cach nam hang mau mot doan - owner doi mau nen roi tuong la hong
// vi khong thay o Fill. Hai o nay la hinh dang CHUNG; mau thi moi box mot bo rieng
// o nam hang ben duoi.
sessZoneBrd   = input.bool(true, "Border", inline = "zbd", group = gZ)
sessZoneBrdW  = input.int(1, "", minval = 1, maxval = 4, inline = "zbd", group = gZ)
sessZoneBrdS  = input.string("Dashed", "", options = ["Solid", "Dashed", "Dotted"], inline = "zbd", group = gZ, tooltip = "Draw the outline or not, then how thick it is and what line style it uses. These two apply to all five boxes; the COLOUR of each border, and its transparency, are set per session in the rows below.\n\nTurn the border off and a box is fill only.")
sessZoneFill  = input.bool(true, "Fill the boxes", group = gZ, tooltip = "Shade the inside of the boxes, each session in its own fill colour from the rows below.\n\nEach fill ships at 90 percent transparent, which tints the session without burying the candles. The opacity slider lives in the colour picker itself, so push it up or down per session.\n\nLondon runs seven and a half hours: on M1 its box alone tints most of the screen. If the chart starts to feel heavy, raise the transparency rather than switching the whole layer off.")

// 23-08: moi phien mot hang - [x] ten | mau VIEN | mau NEN. Mac dinh mau vien = dung
// mau phien ben Session Levels; nen cung mau nhung 90% trong suot. 23-08 owner chot BAT
// nen tu dau: o mau da co san thanh opacity nen bat truoc cho nguoi dung thay, ai thay
// nang thi keo trong suot len chu khong phai di tim cong tac.
zTok  = input.bool(true,  "Tokyo", inline = "zw1", group = gZ)
zTokB = input.color(#FF9800, "", inline = "zw1", group = gZ)
zTokF = input.color(color.new(#FF9800, 90), "", inline = "zw1", group = gZ)
zLon  = input.bool(true,  "London", inline = "zw2", group = gZ)
zLonB = input.color(#2962FF, "", inline = "zw2", group = gZ)
zLonF = input.color(color.new(#2962FF, 90), "", inline = "zw2", group = gZ)
zAm   = input.bool(true,  "NY AM", inline = "zw3", group = gZ)
zAmB  = input.color(#E53935, "", inline = "zw3", group = gZ)
zAmF  = input.color(color.new(#E53935, 90), "", inline = "zw3", group = gZ)
zLu   = input.bool(false, "NY Lunch", inline = "zw4", group = gZ)
zLuB  = input.color(#8D6E63, "", inline = "zw4", group = gZ)
zLuF  = input.color(color.new(#8D6E63, 90), "", inline = "zw4", group = gZ)
zPm   = input.bool(false, "NY PM", inline = "zw5", group = gZ)
zPmB  = input.color(#8E24AA, "", inline = "zw5", group = gZ)
zPmF  = input.color(color.new(#8E24AA, 90), "", inline = "zw5", group = gZ, tooltip = "Which of the five sessions gets a box, and what colour that box is. Two swatches per row: the FIRST is the border, the SECOND is the fill.\n\nEach picker carries its own opacity slider, so the transparency of the border and of the fill are set right there. The fill ships at 90 percent transparent. The Fill switch above turns the whole shading layer off in one click if you want outlines only.\n\nFive boxes stacked across a New York afternoon is a lot of rectangles over the same price - NY Lunch and NY PM are off by default. The master switch above turns the whole layer off; these pick which sessions it draws. The session HIGH and LOW lines are not affected either way - they have their own switches in Session Levels.")
sessZoneDays   = input.int(3, "Boxes kept per session", minval = 1, maxval = 20, group = gZ)
sessZoneLbl    = input.bool(true, "Session name on the box", group = gZ)
sessZoneOpen   = input.bool(false, "Session opening price line", group = gZ)
sessTfMin      = input.timeframe("1", "Draw between", inline = "tf", group = gZ)
sessTfMax      = input.timeframe("M", "and", inline = "tf", group = gZ, tooltip = "Range boxes are drawn only when the chart timeframe sits inside this band. Nothing else is affected.\n\nOn H4 and above a single candle swallows a whole session and the boxes turn into noise - set the upper bound to 60 (H1) if that bothers you.")
sessTfOk       = timeframe.in_seconds(timeframe.period) >= timeframe.in_seconds(sessTfMin) and timeframe.in_seconds(timeframe.period) <= timeframe.in_seconds(sessTfMax)

// =====================================================================
//  EQUAL HIGHS & LOWS
// =====================================================================
gEq = "Equal Highs & Lows"
showEq = input.bool(true, "", inline = "eq", group = gEq)
eqC    = input.color(#00B0FF, "EQH / EQL", inline = "eq", group = gEq)
eqS    = input.string("Dotted", "", options = ["Solid", "Dashed", "Dotted"], inline = "eq", group = gEq)
eqRelIn = input.float(0.25, "Treat as equal when within (gold $)", minval = 0.0, step = 0.05, group = gEq, tooltip = "EQH / EQL  = pivots at the EXACT same quoted price.\nrEQH / rEQL = pivots within this distance of each other.\n\nSet to 0 to keep exact matches only.")

// =====================================================================
//  INTRADAY PIVOTS
// =====================================================================
gPv = "Intraday Pivots"
showPivH1 = input.bool(true, "", inline = "h1", group = gPv)
pvh1C     = input.color(#78909C, "H1 pivots (unswept)", inline = "h1", group = gPv)
pvh1S     = input.string("Solid", "", options = ["Solid", "Dashed", "Dotted"], inline = "h1", group = gPv)

showPivM15 = input.bool(false, "", inline = "m15", group = gPv)
pvm15C     = input.color(#B0BEC5, "M15 pivots (unswept)", inline = "m15", group = gPv)
pvm15S     = input.string("Dotted", "", options = ["Solid", "Dashed", "Dotted"], inline = "m15", group = gPv, tooltip = "M15 pivots are off by default - on a low timeframe chart they alone can fill the screen.")

// =====================================================================
//  SWEPT LEVELS
// =====================================================================
gSw = "Swept Levels"
sweptCol   = input.color(color.gray, "Swept colour", group = gSw, tooltip = "A swept level turns this colour and switches to a dashed line.")
swHistDays = input.int(3, "Swept history depth (days)", minval = 1, maxval = 30, group = gSw, tooltip = "How far back swept levels are kept when the switch above is on. Separate from History depth, which governs live levels.\n\nThis exists because the full window can produce well over a thousand lines against a TradingView ceiling of 500 - past that the oldest ones vanish with no warning. Three days keeps a session review readable and stays inside the limit.")
showSwHist = input.bool(false, "Keep every swept level on the chart", group = gSw, tooltip = "OFF (default) - each timeframe keeps only its most recent swept high and its most recent swept low. This is what keeps the chart readable.\n\nON - every level swept inside the history window stays visible. Good for reviewing a session afterwards.\n\nCAUTION: with M15 pivots also on, 20 days of gold produces roughly 1500 lines against a TradingView ceiling of 500 - the oldest ones are silently dropped and the map looks incomplete. Shorten History depth or turn M15 pivots off before switching this on.")

// =====================================================================
//  DASHBOARD
// =====================================================================
gHud = "Dashboard"
showHud  = input.bool(false, "Show dashboard", group = gHud, tooltip = "A read-out of where the nearest untouched liquidity sits, updated on the last bar.\n\nBSL - buy-side liquidity: the closest level ABOVE price that has not been swept, with its distance.\nSSL - sell-side liquidity: the closest one BELOW.\nDRAW - which of the two is nearer, i.e. the side price has less work to reach.\nSWEPT - the most recent level taken out, and when.\nSESSION - the live session and the current New York time.")
hudPos   = input.string("Top right", "Position", options = ["Top right", "Top left", "Bottom right", "Bottom left", "Middle right", "Middle left"], group = gHud)
hudTheme = input.string("Dark", "Theme", options = ["Dark", "Light"], group = gHud)
hudSize  = input.string("Small", "Size", options = ["Tiny", "Small", "Normal", "Large"], group = gHud)
hudSess  = input.bool(true, "Session row", inline = "hr", group = gHud)
hudSwept = input.bool(true, "Last-swept row", inline = "hr", group = gHud)

// =====================================================================
//  LINES & LABELS
// =====================================================================
gLine = "Lines & Labels"
lineW        = input.int(1, "Line width", minval = 1, maxval = 5, group = gLine)
txtSize      = input.string("Small", "Label text size", options = ["Tiny", "Small", "Normal", "Large"], group = gLine)
keySize      = input.string("Normal", "All-time-high text size", options = ["Tiny", "Small", "Normal", "Large"], group = gLine, tooltip = "The all-time high is the one level worth keeping readable when zoomed out, so it gets its own size.")
labelBack    = input.int(5, "Label offset from the live candle (bars)", minval = 0, group = gLine)
mergeGapIn   = input.float(1.5, "Merge levels closer than (gold $)", minval = 0.0, step = 0.5, group = gLine, tooltip = "Levels on the same side within this distance collapse into one line. The survivor is the more significant one - the all-time high beats previous week, which beats previous day, and so on down to M15 pivots.\n\nSet to 0 to keep every level separate.")
labelCrowd   = input.string("Stagger into columns", "When labels crowd", options = ["Stagger into columns", "Keep the strongest only", "Show all, overlapping"], group = gLine, tooltip = "What to do when two levels sit too close for their labels to both fit.\n\nStagger into columns - the second label steps to the right. Nothing is hidden, but a busy chart grows a few columns of text.\n\nKeep the strongest only - one label per cluster, the most significant level wins: all-time high, then previous week, previous day, two days ago, this week, today, sessions, equal highs/lows, H1, M15. THE LINES ARE ALL STILL DRAWN - only the redundant labels go.\n\nShow all, overlapping - every label at the same column, stacked on top of each other. Densest, and honest about it.\n\nTwo levels count as crowded when they are closer than the gap set below.")
labelGapIn   = input.float(2.0, "Separate labels closer than (gold $)", minval = 0.01, step = 0.5, group = gLine)
labelColBars = input.int(20, "Label column step (bars)", minval = 1, group = gLine, tooltip = "How far right the next column of labels sits when two levels are too close to share one column. Lower it if the far columns end up off screen, raise it if the labels still overlap.")

// =====================================================================
//  ALERTS
// =====================================================================
gAl = "Alerts"
ncAlert   = input.bool(true, "Alert when liquidity is swept", group = gAl, tooltip = "On TradingView create the alert with the condition set to Any alert() function call.")
alertNear = input.bool(false, "Alert when price approaches a level", inline = "an", group = gAl)
nearDistIn = input.float(3.0, "within (gold $)", minval = 0.1, step = 0.5, inline = "an", group = gAl)

// =====================================================================
//  PROJECTION CANDLES  (W -> D -> H4 -> H1, drawn in the right margin)
// =====================================================================
gDc = "Projection Candles"
showWkCandle  = input.bool(false, "Weekly", inline = "cw", group = gDc, tooltip = "Uses the real 1W candle - the same source as the previous / current week levels, so its high and low always line up with them.\n\n1 = the running week only. More than that and earlier weeks stack to the left, labelled 1W-1, 1W-2...")
wcNum         = input.int(1, "bars", minval = 1, maxval = 4, inline = "cw", group = gDc)
showDayCandle = input.bool(false, "Daily", inline = "cd", group = gDc, tooltip = "Aggregates the whole trading day as cut by the Day boundary setting: body = day open to current price, wicks = the day extremes. Follows DST for whichever zone is selected.\n\nThis is the only cluster built by hand from chart candles, so it is meaningful on H1 and below only.")
dcNum         = input.int(1, "bars", minval = 1, maxval = 6, inline = "cd", group = gDc)
showH4Candle  = input.bool(false, "H4", inline = "c4", group = gDc)
h4Num         = input.int(1, "bars", minval = 1, maxval = 6, inline = "c4", group = gDc)
showH1Candle  = input.bool(false, "H1", inline = "c1", group = gDc, tooltip = "Taken straight from the TradingView H1 candle, so it always matches an H1 chart. Labels are in New York time.")
h1Num         = input.int(2, "bars", minval = 1, maxval = 6, inline = "c1", group = gDc)
dcOffset      = input.int(40, "Distance from the live candle (bars)", minval = 1, group = gDc)
dcGap         = input.int(5, "Gap between bars", minval = 2, group = gDc)
dcBody        = input.int(1, "Body width (bars)", minval = 1, group = gDc)
cDcBull       = input.color(#089981, "Up", inline = "dcc", group = gDc)
cDcBear       = input.color(#F23645, "Down", inline = "dcc", group = gDc)
cDcText       = input.color(#787B86, "Label", inline = "dcc", group = gDc)
// --- Cau tao nen, tham khao nhom "5.HTF Candles" cua GTrader-ICT --------------
// Ban goc tach THAN / VIEN / RAU thanh ba cap mau rieng, chua khoang trong giua
// cac cum khung, va cho chon cho dat nhan + can nhan. Mac dinh o day de trung
// mau than nen bat len khong doi gi cho toi khi tu doi.
dcBullBd      = input.color(#089981, "Border", inline = "dcbd", group = gDc)
dcBearBd      = input.color(#F23645, "", inline = "dcbd", group = gDc)
dcBullWk      = input.color(#089981, "Wick", inline = "dcwk", group = gDc)
dcBearWk      = input.color(#F23645, "", inline = "dcwk", group = gDc)
dcGrpGap      = input.int(10, "Gap between timeframe groups (bars)", minval = 0, group = gDc, tooltip = "Extra space inserted between one cluster and the next - weekly, then daily, then H4, then H1. 0 puts them one normal candle gap apart, which is how version 1.0 drew them.")
dcLblPos      = input.string("Top", "Name label", options = ["Top", "Bottom", "Both", "Off"], inline = "dclb", group = gDc)
dcLblAlign    = input.string("Follow candles", "", options = ["Follow candles", "Align"], inline = "dclb", group = gDc, tooltip = "Follow candles - each label sits on its own candle's high or low, so the row of labels is as ragged as the candles.\n\nAlign - every label in one cluster sits at the same level, taken from the highest high and the lowest low of that cluster.")
dcTimer       = input.bool(false, "Countdown", inline = "dcex", group = gDc)
dcIntvl       = input.bool(false, "Date", inline = "dcex", group = gDc)
dcPxLbl       = input.bool(false, "Price", inline = "dcex", group = gDc, tooltip = "Countdown - time left on the candle still running, written under its name. The daily cluster has none: it is aggregated by hand from the chart candles, so there is no exact close time to count down to.\n\nDate - weekday for the daily cluster, day/month for the weekly, opening time for H4 and H1. Sits under the candle. All three are read in New York time, whatever the Day boundary at the top is set to.\n\nPrice - the candle's close, written to the right of its body.")
dcTrace       = input.bool(false, "Trace lines back to the live candle", group = gDc, tooltip = "Horizontal lines run from the live candle across the empty margin to the projected candle, one for each of its open, high, low and close - so a level read off the cluster can be followed back to price.\n\nOnly the candle still running in each cluster gets them.")
dcTrOOn       = input.bool(true, "", inline = "dtro", group = gDc)
dcTrOC        = input.color(#787B86, "Open ", inline = "dtro", group = gDc)
dcTrOS        = input.string("Dotted", "", options = ["Solid", "Dashed", "Dotted"], inline = "dtro", group = gDc)
dcTrCOn       = input.bool(true, "", inline = "dtrc", group = gDc)
dcTrCC        = input.color(#787B86, "Close", inline = "dtrc", group = gDc)
dcTrCS        = input.string("Dotted", "", options = ["Solid", "Dashed", "Dotted"], inline = "dtrc", group = gDc)
dcTrHOn       = input.bool(true, "", inline = "dtrh", group = gDc)
dcTrHC        = input.color(#787B86, "High ", inline = "dtrh", group = gDc)
dcTrHS        = input.string("Dotted", "", options = ["Solid", "Dashed", "Dotted"], inline = "dtrh", group = gDc)
dcTrLOn       = input.bool(true, "", inline = "dtrl", group = gDc)
dcTrLC        = input.color(#787B86, "Low  ", inline = "dtrl", group = gDc)
dcTrLS        = input.string("Dotted", "", options = ["Solid", "Dashed", "Dotted"], inline = "dtrl", group = gDc)

// =====================================================================
//  ICT MACROS   (port tu GTrader-ICT All In One - Community Version)
//  Moi macro = mot cua so 20 phut. Ve vach TREN (cuc dai) + vach DUOI
//  (cuc tieu) chay dan theo gia trong suot cua so, cong mot nhan "MACRO".
//  Do la LOP DUY NHAT cua GTrader ma Neiro chua he co.
//  LUU Y: day thuan tuy la lop HIEN THI - no khong sinh tin hieu nao.
// =====================================================================
gMC = "ICT Macros"
mcOn     = input.bool(true, "Macro windows", group = gMC, tooltip = "The ICT macro windows: a 20 minute box either side of the hour where price is expected to run for liquidity.\n\nDrawn as two lines that trail the running high and low of the window, plus a MACRO label.")
mcTfLim  = input.int(3, "Only draw at or below (minutes)", minval = 1, maxval = 240, group = gMC, tooltip = "A macro is 20 minutes long. On M15 that is barely one candle, so the original refuses to draw above M3. Raise it if you want them on M5 or M15 anyway.")
mcDistIn = input.float(2.0, "Line offset from the extreme (gold $)", minval = 0.0, step = 0.1, group = gMC, tooltip = "How far outside the macro high and low the two lines sit, so they do not sit exactly on the wicks. The original ships 0.5; this build defaults to 2 so the lines clear gold's wicks. It is in dollars - it is rescaled by the Scale thresholds to symbol setting at the top, like every other dollar figure here.")
mcCol    = input.color(#787B86, "Lines & label", group = gMC, tooltip = "The original paints these with the chart foreground colour, which is black on a light chart and white on a dark one. Default here is the neutral grey used by the rest of this indicator, so the macro reads the same on either background.\n\nSwitch it to white if you want the macro to shout on a dark chart, or black on a light one.")
mcKeep   = input.int(1, "Macros kept per window", minval = 1, maxval = 20, group = gMC, tooltip = "How many past occurrences of EACH macro window stay on the chart. The original ships with 1 - only the one running now, or the last one that ran.")
mcTZ     = input.string("America/New_York", "Timezone", options = ["America/New_York","GMT-12","GMT-11","GMT-10","GMT-9","GMT-8","GMT-7","GMT-6","GMT-5","GMT-4","GMT-3","GMT-2","GMT-1","GMT+0","GMT+1","GMT+2","GMT+3","GMT+4","GMT+5","GMT+6","GMT+7","GMT+8","GMT+9","GMT+10","GMT+11","GMT+12","GMT+13","GMT+14"], group = gMC, tooltip = "Clock the macro windows are read in. GMT entries are NOT adjusted for daylight saving - that is the original's own note.\n\nSeparate from the Day boundary at the top: it moves the macros, nothing else.")

mc1On = input.bool(true, "", inline = "mc1", group = gMC)
mc1S  = input.string("09:50", "", inline = "mc1", group = gMC)
mc1E  = input.string("10:10", "", inline = "mc1", group = gMC)
