tsDirVi     = input.string("Cả hai", "Chiều tín hiệu", options = ["Cả hai","Chỉ tăng","Chỉ giảm"], group = "4 · TURTLE SOUP — luật (iFVG, vạch CISD)", tooltip = "Chỉ của riêng Turtle Soup: lọc cú theo chiều đảo. Chỉ tăng = chỉ nhận cú mua (nến cực trị là đáy); Chỉ giảm = chỉ nhận cú bán (nến cực trị là đỉnh).\n\nJudas có ô chiều riêng trong nhóm luật của nó, hai bên chỉnh độc lập.")
tsSweep     = input.bool(false, "Nến cực trị — chỉ nhận cây ĐÃ QUÉT (swept)", group = "4 · TURTLE SOUP — luật (iFVG, vạch CISD)", tooltip = "MẶC ĐỊNH TẮT — không đòi nến cực trị phải quét, mọi nến cực trị đều được dựng cú.\n\nSWEPT (còn gọi là displacement) KHÔNG phải tên gọi khác của nến cực trị — nó là bộ lọc trong chính ô này. Đạt luật swept nghĩa là nến cực trị thò RÂU ra quét qua đỉnh/đáy nến liền trước rồi kéo THÂN về:\n• Đảo lên: đáy nến cực trị thủng xuống dưới đáy nến liền trước, nhưng phần thấp nhất của THÂN (giữa giá mở và giá đóng) vẫn nằm TRÊN đáy nến đó.\n• Đảo xuống lật ngược: đỉnh nến cực trị thò lên trên đỉnh nến liền trước, thân vẫn nằm dưới.\n\nKhông đạt thì Turtle Soup bỏ cú đó, không vẽ vạch CISD. Ô RIÊNG của Turtle Soup — Judas có ô giống hệt trong nhóm luật của nó, hai bên chỉnh độc lập.\n\nĐây chính là ô nến cực trị phải quét của bản CRB-Model cũ — bên đó chỉ Turtle Soup mới có, nay Judas cũng có ô của riêng mình.")
tsFvgAtrLen = input.int(100, "iFVG — ATR: chu kỳ, hệ số", minval = 1, maxval = 500, inline = "tg", group = "4 · TURTLE SOUP — luật (iFVG, vạch CISD)")
tsFvgMult   = input.float(0.50, "", minval = 0, maxval = 5, step = 0.05, inline = "tg", group = "4 · TURTLE SOUP — luật (iFVG, vạch CISD)", tooltip = "ĐỂ 0 = GIAO Ô NÀY CHO BẢNG 3 LÁI. Hệ số sẽ tự nhảy theo khung chart đang mở. Gõ số khác 0 thì số đó thắng, bảng 3 không đụng tới. Hai cơ chế ĐỘC LẬP — giao Judas cho bảng mà vẫn giữ tay Turtle Soup cũng được.\n\nMUỐN BỎ HẲN NGƯỠNG bề rộng thì đặt DÒNG tương ứng của bảng 3 về 0, đừng đặt ô này về 0.\n\nNGƯỠNG BỀ RỘNG iFVG, riêng của Turtle Soup — Judas có ngưỡng riêng trong nhóm luật của nó, hai bên không dính nhau. iFVG hẹp hơn ATR × hệ số thì Turtle Soup coi như không tồn tại: dù có bị lấp cũng không ra tín hiệu.\n\nMẶC ĐỊNH ATR 100 × 0,50 — owner chốt 24-08, thay cho 0,25. Đây là LỰA CHỌN CỦA OWNER, không phải kết luận của phép đo nào: toàn bộ research đã xoá hẳn 24-08 vì đo sai.\n\nTRƯỚC ĐÂY CÓ Ô TRẦN đi kèm (tsFvgMax, mặc định 0,95). ĐÃ XOÁ HẲN 23-08 vì nó là một cái bẫy: code kẹp trần lên bằng sàn, nên đặt trần thấp hơn sàn là chart im lặng không vẽ gì và Pine không báo lỗi.\n\nCHU KỲ dùng chung với Judas (cùng 100). Đừng chỉnh chu kỳ — chỉ HỆ SỐ mới là trục thật.")
tsFvgWin    = input.int(15, "iFVG — N nến từ cực trị sang TRÁI (tính cả cực trị)", minval = 1, maxval = 30, group = "4 · TURTLE SOUP — luật (iFVG, vạch CISD)", tooltip = "Đếm CÂY GIỮA của bộ 3 nến tạo ra khe hở. Cửa sổ bắt đầu TẠI CHÍNH nến cực trị rồi trải sang TRÁI cho đủ N nến.\n\nMẶC ĐỊNH 15: cây giữa phải nằm trong khoảng từ (cực trị − 4) tới (cực trị), tính cả nến cực trị.\n\nKhe hở phải NGƯỢC chiều cú đảo: cú BÁN đi tìm khe TĂNG cũ, cú MUA đi tìm khe GIẢM cũ. Đó chính là định nghĩa iFVG — FVG của cú đẩy trước, bị giá quay lại lấp nên lật vai.\n\nLẤP = có nến ĐÓNG CỬA xuyên hẳn qua mép xa của khe. Chạm rồi bật lên không tính. Nến lấp phải nằm TỪ nến cực trị trở đi. Trong số các iFVG hợp lệ, Turtle Soup lấy cái BỊ LẤP SỚM NHẤT.\n\nCÙNG CON SỐ NÀY LÀ HẠN CHỜ NẾN LẤP, đếm từ nến cực trị sang PHẢI — không có ô hạn chờ riêng. Quá N nến mà chưa có iFVG nào bị lấp thì Turtle Soup bỏ cú, XOÁ HẲN vạch CISD lẫn chữ CISD.")
tsNeedCisd  = input.bool(false, "Vạch CISD — bắt buộc có nến đóng cửa xuyên qua", group = "4 · TURTLE SOUP — luật (iFVG, vạch CISD)", tooltip = "MẶC ĐỊNH TẮT (owner chốt 24-08, đảo ngược từ BẬT) — iFVG bị lấp là ra tín hiệu ngay, không cần biết vạch CISD đã bị xuyên chưa. Đó là LUẬT GỐC của Turtle Soup: CÓ CISD và CÓ khe hở bị lật là đủ.\n\nBẬT lên thì thêm một điều kiện: chính cái nến lấp iFVG đó phải đồng thời ĐÓNG CỬA xuyên qua vạch CISD — hai việc trong CÙNG một nến. Râu thò qua rồi kéo về không tính, và giá đã từng xuyên vạch ở một nến khác cũng không tính.\n\nChỗ bật/tắt thật sự khác nhau: luật chỉ đòi khe bị lấp TỪ CÂY CỰC TRỊ TRỞ ĐI, nên cây lấp có thể nằm TRƯỚC nến ra sự kiện CISD — lúc đó nó gần như chắc chắn chưa vượt mức CISD. Bật là loại đúng mấy cú đó, tắt là nhận hết.\n\nVÌ ĐANG TẮT nên ô ‹Mũi tên — độ RÕ khi chưa qua vạch› bên nhóm hiển thị của Turtle Soup có tác dụng trở lại: mũi tên vừa ra vẽ mờ, tự sáng 100% khi giá đóng cửa xuyên vạch CISD.\n\nÔ này song sinh với ô ‹Vạch MSS — bắt buộc có nến đóng cửa xuyên qua› của Judas, và từ 25-08 tối HAI BÊN CÙNG TẮT (owner chốt). Trước đó lệch nhau có ý: Judas BẬT, Turtle Soup TẮT.")
tsNeedIfvg  = input.bool(true, "Yêu cầu có iFVG (FVG mới đè lên FVG cũ)", group = "4 · TURTLE SOUP — luật (iFVG, vạch CISD)", tooltip = "BẬT: Bắt buộc nhịp giá lấp FVG cũ phải tự tạo ra một FVG mới ngược chiều và đè lên vùng giá của FVG cũ (chuẩn mô hình Inversion FVG mạnh).\nTẮT: Chỉ cần giá đóng cửa lấp qua FVG cũ là đủ điều kiện (luật cũ).")

