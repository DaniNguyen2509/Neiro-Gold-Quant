// --------------------------------------------------------------------
// NHOM 9-11 · CRB — chep NGUYEN VAN tu CRB-Model.pine (dong 986-1076).
// Khong doi mot o nao, ke ca so nhom.
// --------------------------------------------------------------------
// method txSz: doi chuoi "Tiny/Small/..." -> hang so size.*, cum CRB goi kieu
// method (seSz.txSz()). Lan truoc chep helper bi SOT dung ham nay.
method txSz(string s) =>
    out = switch s
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Normal" => size.normal
        "Large"  => size.large
        "Huge"   => size.huge

// ---- HELPER cua cum CRB (chep tu Neiro-ICT: luat gap-3 + 3 bo trim) ----
nsGap(int off, int dir) =>
    dir == 1 ? low[off] > high[off + 2] : high[off] < low[off + 2]
trimLn(a, int keep) =>
    while array.size(a) > keep
        x = array.shift(a)
        if not na(x)
            line.delete(x)
trimLb(a, int keep) =>
    while array.size(a) > keep
        x = array.shift(a)
        if not na(x)
            label.delete(x)
trimBx(a, int keep) =>
    while array.size(a) > keep
        x = array.shift(a)
        if not na(x)
            box.delete(x)



// --------------------------------------------------------------------
// 7 · OLHC — cấu trúc nến. THỨ DUY NHẤT v4 thêm so với v3.
// Cụm ĐỘC LẬP HOÀN TOÀN: không đọc state của JUDAS / TURTLE SOUP / CRB,
// không dùng chung ô nào của chúng, và KHÔNG đi qua bộ lọc BIAS H1 của
// NHOM 2. Tắt nhóm này thì v4 chạy y hệt v3, không xê dịch một ly.
//
// Nguyên tắc: mọi kết luận chỉ rút từ BỐN SỐ của CHÍNH cây nến đó.
//   UW = high - max(open, close)      upper wick
//   BD = |close - open|               body
//   LW = min(open, close) - low       lower wick
//   UW + BD + LW = high - low         ba gap phủ kín range, tổng = 100%
// Ngoại lệ duy nhất là ô lọc ATR - ATR bắt buộc phải lấy từ chuỗi nến.
// --------------------------------------------------------------------
gOL = "7 · OLHC — cấu trúc nến"
bool   olOn      = input.bool(true, "OLHC — bật cụm", group = gOL, tooltip = "MẶC ĐỊNH BẬT (owner chốt 25-08).\n\nĐánh dấu hai dạng nến bị TỪ CHỐI GIÁ, đọc từ một cây nến duy nhất:\n\n• OHLC = open → high → low → close. Upper wick dài, giá thọc LÊN rồi bị đẩy ngược → tín hiệu GIẢM.\n• OLHC = open → low → high → close. Lower wick dài, giá thọc XUỐNG rồi bị đẩy ngược → tín hiệu TĂNG.\n\n⚠ Bốn số O/H/L/C KHÔNG chứa thứ tự giá đã đi. Một cây upper wick dài hoàn toàn có thể đã xuống low TRƯỚC rồi mới lên high. Tên OHLC / OLHC ở đây đọc theo HÌNH DẠNG, không phải đường đi đã chứng minh.\n\n⚠ Cụm này chỉ đo hình dạng một cây nến. Nó KHÔNG kiểm tra cây đó có lấy mất một swing high / swing low cũ hay không - nên chưa phải liquidity raid đúng nghĩa ICT. Chữ wick QUÉT chỉ là tên gọi cho cái wick DÀI.")
float  olGap1    = input.float(45, "GAP 1 · wick QUÉT tối thiểu (%)", minval = 0, maxval = 100, step = 1, group = gOL, tooltip = "Gap DÀI - phía giá thọc vào rồi bị đẩy ngược trở lại. Với OHLC đây là UPPER wick, với OLHC là LOWER wick. Một bộ số tự soi gương cho cả hai cấu trúc.\n\nNâng lên là siết chặt, chỉ còn pin bar thật. Hạ xuống là chart dày dấu.")
float  olGap2    = input.float(45, "GAP 2 · body tối đa (%)", minval = 0, maxval = 100, step = 1, group = gOL, tooltip = "Thân nến tính theo % range. Body càng nhỏ thì cây càng giống pin bar, và gap 1 càng mang ý nghĩa từ chối giá. Đặt 100 là bỏ hẳn điều kiện body.")
float  olGap3    = input.float(25, "GAP 3 · wick ĐỐI tối đa (%)", minval = 0, maxval = 100, step = 1, group = gOL, tooltip = "Gap NGẮN, nằm ở phía ĐỐI DIỆN gap 1. Với OHLC đây là lower wick, với OLHC là upper wick.\n\nMục đích: chặn những cây hai đầu đều dài (long-legged doji) - loại đó không nghiêng về bên nào. Đặt 100 là bỏ hẳn điều kiện này.")
bool   olUseK    = input.bool(true, "Thêm ràng buộc: GAP 1 ≥ K × GAP 3", inline = "ol1", group = gOL)
float  olK       = input.float(2.0, "", minval = 1, maxval = 10, step = 0.1, inline = "ol1", group = gOL, tooltip = "Ba ô % ở trên đo TỪNG gap so với RANGE của nến - mỗi gap một ngưỡng riêng. Ô này đo TRỰC TIẾP gap 1 với gap 3.\n\nVí dụ gap1 = 46% và gap3 = 24%: cả ba ô % đều đạt, nhưng 46 nhỏ hơn 2 × 24 nên K = 2 loại cây đó ra.\n\nVới mặc định hiện tại nó chỉ siết thêm một viền mỏng (45 chia 25 đã là 1,8). Nó chỉ thật sự có tác dụng khi bạn nới lỏng ba ô %. Đặt K = 1,0 là tắt hẳn.")
bool   olAtrOn   = input.bool(true, "Lọc nến mạnh: range ≥ ATR × hệ số", inline = "ol2", group = gOL)
int    olAtrLen  = input.int(14, "", minval = 1, maxval = 500, inline = "ol2", group = gOL)
float  olAtrMult = input.float(1.0, "", minval = 0.1, maxval = 10, step = 0.1, inline = "ol2", group = gOL, tooltip = "MẶC ĐỊNH BẬT (owner chốt 25-08). Ô bật, chu kỳ ATR và hệ số nằm cùng một dòng.\n\nĐây là ô DUY NHẤT của nhóm 9 phá nguyên tắc một-cây-nến: ATR bắt buộc phải lấy từ chuỗi nến trước đó.\n\nVì sao cần: ba ô % chỉ đo TỶ LỆ, nên một cây bé tí vẫn có thể có tỷ lệ wick rất đẹp và lọt lưới. Lọc này cắt đúng loại đó. Đo bằng ATR chứ không bằng số giá cố định nên nó tự co giãn theo từng phiên và từng mã.\n\n1,0 = nến phải dài bằng một ATR. Nâng lên 1,5 hay 2,0 là chỉ còn những cây thật sự trồi lên khỏi nền.")
bool   olMark    = input.bool(true, "Tam giác đánh dấu", group = gOL, tooltip = "OHLC: tam giác CHÚI XUỐNG đặt TRÊN nến. OLHC: tam giác CHÚI LÊN đặt DƯỚI nến.\n\nHướng mũi tên và màu đều đi theo TÍN HIỆU, không theo chiều đóng của nến - một cây đóng giảm vẫn có thể là OHLC.\n\nCỡ cố định ở mức nhỏ nhất: Pine bắt cỡ của plotshape phải là hằng số nên không mở ra tuỳ chỉnh được.")
bool   olLbl     = input.bool(false, "Nhãn OHLC / OLHC", inline = "ol3", group = gOL)
string olLbSz    = input.string("Vừa", "", options = ["Nhỏ", "Vừa", "To"], inline = "ol3", group = gOL, tooltip = "MẶC ĐỊNH TẮT cho chart đỡ rối. Nhãn chỉ ghi 4 chữ cái; số ba gap kèm cả giá lẫn % nằm trong TOOLTIP của nhãn - rê chuột vào nhãn là thấy.")
bool   olBar     = input.bool(true, "Tô màu cả cây nến", group = gOL, tooltip = "Tô bao trùm cả body lẫn hai wick. Nến không đạt thì giữ nguyên màu chart.\n\n⚠ Ô này KHÔNG chịu ô giới hạn bên dưới - Pine không xoá lại được màu đã tô lên nến cũ, nên bật lên là mọi cây đạt đều được tô từ đầu lịch sử.")
