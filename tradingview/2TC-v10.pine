bool   extDotAll = extDotVi == "Mọi nến cực trị CISD"
cisdExtStyleV    = cisdExtStyleVi == "Nét liền" ? line.style_solid : cisdExtStyleVi == "Nét đứt" ? line.style_dashed : line.style_dotted

// ta.atr PHAI goi o global scope (moi nen) — dung de day mui ten/chu ra khoi nen.
float sAtr = nz(ta.atr(14), high - low)

// HAI NGUONG BE RONG KHE HO, TACH HAN NHAU. Moi co che mot chu ky ATR + he so.
float jdFvgAtr = nz(ta.atr(jdFvgAtrLen), high - low)
float tsFvgAtr = nz(ta.atr(tsFvgAtrLen), high - low)

float jdMultEff = jdFvgMult
float tsMultEff = tsFvgMult

float jdNeedW  = jdFvgAtr * jdMultEff
float tsNeedW  = tsFvgAtr * tsMultEff
// Kho khe ho quet MOT LAN moi nen -> phai ghi theo nguong LONG HON trong hai
// cai, roi luc CHON moi co che ap nguong rieng cua no. Neu ghi theo nguong
// gat hon thi ben long hon se mat ung vien vinh vien.
float storeNeedW = math.min(jdNeedW, tsNeedW)

// Ro khe ho phai giu du lau: co che TURTLE SOUP di tim khe CU nam ben TRAI
// cuc tri, ma su kien CISD co the no ra rat lau sau cuc tri. De sat dgKeep
// la mat ung vien -> san so ban ghi len it nhat 120. Ban ghi re, chi cai HOP
// moi an vao tran 500 hinh, ma hop chi ton tai khi khe con TUOI.
int fvgKeepEff = math.max(dgKeep, 120)

// #####################################################################
// #                                                                   #
// #   KHUC GOC DUNG CHUNG: may CISD -> CAY CUC TRI -> buoc xac dinh   #
// #   CAY NEO. Het phan chung o day.                                  #
// #   Cong displacement KHONG con dung chung: moi co che mot o rieng   #
// #   (jdSweep / tsSweep), chi ham do f_swept la dung chung.           #
// #                                                                   #
// #####################################################################

// =====================================================================
// ============ MAY CISD (nguyen van tu CRB-Model) =====================
// =====================================================================
// THAM SO `base` (them 23-08 cho tinh nang Follow BIAS H1):
//   base = 0 -> doc nen HIEN TAI. Moi cho goi cu deu truyen 0 -> hanh vi
//               KHONG doi mot ly so voi truoc.
//   base = 1 -> doc nen DA DONG. Chi engine H1 trong request.security dung,
//               vi trong do phai tranh nen dang hinh thanh.
// Nho tham so nay ma LUAT chi co MOT ban duy nhat, khong phai chep doi cho
// engine H1 — dung tinh than 33 o / 33 o cua file.
f_candleAttitude(int offset, int base) =>
    o = open[offset + base]
    c = close[offset + base]
    c > o ? 1 : (c < o ? -1 : 0)

f_consultCrystalBall(int biasIn, int base) =>
    float extreme = open[base]
    int extremeOffset = 0
    int att0 = f_candleAttitude(0, base)
    if att0 != 0 and att0 == biasIn
        for i = 1 to 500
            int att = f_candleAttitude(i, base)
            if att != 0
                if att != biasIn
                    break
                else
                    if biasIn == 1
                        if open[i + base] < extreme
                            extreme := open[i + base]
                            extremeOffset := i
                    else
                        if open[i + base] > extreme
                            extreme := open[i + base]
                            extremeOffset := i
    [extreme, bar_index - base - extremeOffset]

f_archaeologistJones(int biasIn, int base) =>
    bool artifactFound = false
    int maxOffset = -1
    float extreme = 0.0
    for j = 1 to 500
        int att = f_candleAttitude(j, base)
        if att != 0
            bool correctEra = att == biasIn
            if not artifactFound
                if correctEra
                    artifactFound := true
                    maxOffset := j
                    extreme := open[j + base]
            else
                if not correctEra
                    break
                maxOffset := j
                if biasIn == 1
                    if open[j + base] < extreme
                        extreme := open[j + base]
                else
                    if open[j + base] > extreme
                        extreme := open[j + base]
    float outExtreme = na
    int outAbsIdx = na
    if maxOffset < 0
        outExtreme := open[base]
        outAbsIdx := bar_index - base
    else
        int extremeOffset = maxOffset
        for k = maxOffset to 1
            if open[k + base] == extreme
                extremeOffset := k
                break
        outExtreme := extreme
        outAbsIdx := bar_index - base - extremeOffset
    [outExtreme, outAbsIdx]

// CISD: dir=1 -> LOW thap nhat, dir=-1 -> HIGH cao nhat.
f_findExtremeBar(int dir, int fromAbs, int toAbs, int base) =>
    int vIdx = bar_index - base
    int offsetFrom = vIdx - fromAbs
    int offsetTo   = vIdx - toAbs
    int bestOffset = offsetFrom
    float bestVal  = dir == 1 ? low[offsetFrom + base] : high[offsetFrom + base]
    if offsetFrom - 1 >= offsetTo
        for off = offsetFrom - 1 to offsetTo
            if dir == 1
                if low[off + base] < bestVal
                    bestVal := low[off + base]
                    bestOffset := off
            else
                if high[off + base] > bestVal
                    bestVal := high[off + base]
                    bestOffset := off
    vIdx - bestOffset

// LUAT DISPLACEMENT: cay cuc tri phai tho rau qua nen lien truoc roi keo THAN
// ve. Nguyen van luat displacementFilter cua ban cu. Ham do MOT LAN moi su kien,
// roi tung co che tu quyet co ap hay khong bang o rieng cua no (jdSweep/tsSweep).
f_swept(int dir, int extAbs, int base) =>
    bool ok = false
    int vIdx = bar_index - base
    int o = vIdx - extAbs
    if o >= 0 and extAbs - 1 >= 0
        int p = o + 1
        if dir == 1
            float bodyLow = math.min(open[o + base], close[o + base])
            ok := low[o + base] < low[p + base] and bodyLow > low[p + base]
        else
            float bodyHigh = math.max(open[o + base], close[o + base])
            ok := high[o + base] > high[p + base] and bodyHigh < high[p + base]
    ok

// CAY NEO cua JUDAS: tu cuc tri dem NGUOC sang trai i-1..i-N, lay cay DAU
// TIEN "thut" so voi cay ben trai lien ke cua no.
f_ancMss(int dir, int extAbs, int base) =>
    int vIdx = bar_index - base
    int res = -1
    // Owner 23-08: xet NGUOC sang trai dung jdAncBack nen, TINH CA cay cuc
    // tri (j = 0). Truoc day bat dau tu j = 1 nen bo qua chinh cay cuc tri.
    for j = 0 to jdAncBack - 1
        if extAbs - j - 1 >= 0
            int o = vIdx - extAbs + j
            if (dir == 1 ? low[o + base] > low[o + 1 + base] : high[o + base] < high[o + 1 + base])
                res := extAbs - j
                break
    res

// CAY NEO cua TURTLE SOUP: KHONG con ham rieng nua (owner 23-08 toi).
// Vach CISD = originPrice / originIndex ma chinh may CISD o tren da tinh —
// xem khoi chu thich tai cho dung, trong nhanh TURTLE SOUP.

// =====================================================================
// ============================ KIEU DU LIEU ===========================
// =====================================================================
// KHO KHE HO DUNG CHUNG. midAbs = cay GIUA — cay tao ra khe ho. w = BE RONG
// khe (moi co che tu ap nguong rieng len con so nay luc CHON vao lenh).
// fillAbs = nen DONG xuyen han mep xa (= luc khe hoa thanh iFVG).
type FvgZ
    bool  bull
    float top
    float btm
    float w
    int   midAbs
    float hiM
    float loM
    float hi3     // dinh/day CAY THU BA — cay lam khe ho THANH HINH
    float lo3
    bool  alive
    int   fillAbs
    float fillCls
    float fillHi
    float fillLo
    box   bx

// Mot cu cua CO CHE JUDAS. Song hoan toan rieng, khong biet MechRec ton tai.
type MechRec
    int   dir
    int   extAbs
    float extPx
    int   ancAbs
    float lvl
    int   brkBar
    bool  done
    bool  dead
    line  ln
    label lb
    label sLb
    line  sSt
    box   sBx

// Mot cu cua CO CHE TURTLE SOUP. Song hoan toan rieng, khong biet MechRec.

// Hinh ve cua MOT tin hieu da ban. Moi co che giu mot mang rieng.
type SigSet
    label lb
    line  stem
    box   bx
    // 24-08: bo hinh tin hieu GIU LUON vach MSS / CISD cua chinh cu do. Truoc
    // day vach nam trong MechRec/MechRec nen bi xoa theo mang CU (20 cu = vai gio),
    // trong khi mui ten song theo mang TIN HIEU (20 tin hieu = nhieu ngay) ->
    // mui ten tro tro mot minh, khong con vach.
    line  vLn
    label vLb

// Vach cuc tri CISD ("CISD Max") — lop chan doan chung, nguyen van kent_v9.
type ExtLine
    line  ln
    label lb
    int   dir
    float px
    bool  active



// =====================================================================
// ============================ TRANG THAI =============================
// =====================================================================
// --- khuc goc chung ---
var int   bias             = 0
var float originPrice      = 0.0
var int   originIndex      = -1
var float extremeThreshold = 0.0
var bool  initialized      = false
var array<FvgZ>  fvgArr    = array.new<FvgZ>()
var array<label> extDots   = array.new<label>()
var ExtLine        cisdCurExt = na
var array<ExtLine> cisdOldExt = array.new<ExtLine>()
// --- co che JUDAS ---
var array<MechRec>  jdArr    = array.new<MechRec>()
var array<SigSet> jdSigArr = array.new<SigSet>()
// --- co che TURTLE SOUP ---
var array<MechRec>  tsArr    = array.new<MechRec>()
var array<SigSet> tsSigArr = array.new<SigSet>()

// Co bao tin hieu moi trong nen nay. KHONG co `var` -> moi nen tu ve false.
bool alJd = false
bool alTs = false

// =====================================================================
// ============================ HAM PHU ================================
// =====================================================================
// Mau vach MSS (cua Judas). okBrk = da co nen DONG xuyen qua vach chua.
f_mssCol(int dir, bool okBrk, int transp) =>
    color c = okBrk ? (dir == 1 ? mssColBull : mssColBear) : (dir == 1 ? mssColBullW : mssColBearW)
    color.new(c, transp)

// Mau vach CISD (cua Turtle Soup). Bo mau TACH HAN khoi vach MSS.
f_cisdCol(int dir, bool okBrk, int transp) =>
    color c = okBrk ? (dir == 1 ? cisdColBull : cisdColBear) : (dir == 1 ? cisdColBullW : cisdColBearW)
    color.new(c, transp)

// Bien 1 vach cuc tri hien hanh thanh "cu". Nguyen van kent_combo_v9.
f_retireExt(ExtLine e, string prefixP, color colOld, array<ExtLine> oldArr, int keepOld, int lockX) =>
    if not na(e) and not na(e.ln)
        e.active := false
        line.set_color(e.ln, colOld)
        if lockX > 0
            line.set_x2(e.ln, lockX)
        if not na(e.lb)
            label.set_textcolor(e.lb, colOld)
            label.set_text(e.lb, "P." + prefixP)
        array.push(oldArr, e)
        while array.size(oldArr) > keepOld
            ExtLine ed = array.shift(oldArr)
            if not na(ed.ln)
                line.delete(ed.ln)
            if not na(ed.lb)
                label.delete(ed.lb)

// Xóa sạch các object của một tín hiệu (dùng chung cho JD và TS)
f_killMech(MechRec r) =>
    if not na(r.ln)
        line.delete(r.ln)
    if not na(r.lb)
        label.delete(r.lb)
    if not na(r.sLb)
        label.delete(r.sLb)
    if not na(r.sSt)
        line.delete(r.sSt)
    if not na(r.sBx)
        box.delete(r.sBx)

// TO MAU HINH TIN HIEU theo trang thai vach: vach CHUA bi xuyen -> ve MO theo
// o do mo cua co che; xuyen roi -> ro 100%. Goi lai duoc nhieu lan, khong ve lai
// hinh nao, chi doi mau tai cho (owner chot 23-08).
f_jdPaint(MechRec r) =>
    if not na(r.sLb)
        color cJ = r.dir == 1 ? jdColBull : jdColBear
        color cB = r.dir == 1 ? jdBoxBull : jdBoxBear
        float tr = r.brkBar >= 0 ? 0.0 : jdSigDim
        float k  = (100.0 - tr) / 100.0
        label.set_textcolor(r.sLb, color.new(cJ, tr))
        if not na(r.sSt)
            line.set_color(r.sSt, color.new(cJ, tr))
        if not na(r.sBx)
            box.set_border_color(r.sBx, color.new(cB, 100.0 - jdBoxOp * k))
            box.set_bgcolor(r.sBx, jdBoxFill > 0 ? color.new(cB, 100.0 - jdBoxFill * k) : na)

f_tsPaint(MechRec r) =>
    if not na(r.sLb)
        color cT = r.dir == 1 ? tsColBull : tsColBear
        color cB = r.dir == -1 ? tsBoxBull : tsBoxBear
        float tr = r.brkBar >= 0 ? 0.0 : tsSigDim
        float k  = (100.0 - tr) / 100.0
        label.set_textcolor(r.sLb, color.new(cT, tr))
        if not na(r.sSt)
            line.set_color(r.sSt, color.new(cT, tr))
        if not na(r.sBx)
            box.set_border_color(r.sBx, color.new(cB, 100.0 - tsBoxOp * k))
            box.set_bgcolor(r.sBx, tsBoxFill > 0 ? color.new(cB, 100.0 - tsBoxFill * k) : na)

// Day mot bo hinh tin hieu vao mang cua CO CHE do + cat bot cho nhe chart.
f_pushSig(array<SigSet> arr, label lb, line st, box bx, line vLn, label vLb, int keep) =>
    array.push(arr, SigSet.new(lb, st, bx, vLn, vLb))
    while array.size(arr) > keep
        SigSet sd = array.shift(arr)
        if not na(sd.lb)
            label.delete(sd.lb)
        if not na(sd.stem)
            line.delete(sd.stem)
        if not na(sd.bx)
            box.delete(sd.bx)
        // vach di theo mui ten, khong di theo cu (24-08)
        if not na(sd.vLn)
            line.delete(sd.vLn)
        if not na(sd.vLb)
            label.delete(sd.vLb)

// =====================================================================
//  KHO KHE HO (du lieu chung) — chay TRUOC may CISD trong cung nen, de khe
//  ho vua hoan tat tren chinh cay nay da dung duoc ngay.
//  Ghi theo NGUONG LONG HON trong hai nguong; moi co che ap nguong rieng
//  cua no luc CHON vao lenh.
// =====================================================================
if anyMech and inWin and barstate.isconfirmed and bar_index >= 2
    // 1) khe ho bi LAP: THAN nen DONG xuyen qua mep XA. Ban ghi VAN GIU LAI
    //    (co che Turtle Soup song bang chinh may cai da bi lap), chi xoa hop.
    if array.size(fvgArr) > 0
        for gi = array.size(fvgArr) - 1 to 0
            FvgZ z = array.get(fvgArr, gi)
            if z.alive
                if (z.bull ? close < z.btm : close > z.top)
                    z.alive   := false
                    z.fillAbs := bar_index
                    z.fillCls := close
                    z.fillHi  := high
                    z.fillLo  := low
                    if not na(z.bx)
                        box.delete(z.bx)
                        z.bx := na
    // 2) khe ho moi tai nen vua dong (cay 3 = offset 0, cay 1 = offset 2)
    bool gapUp = low[0]  > high[2]
    bool gapDn = high[0] < low[2]
    if gapUp or gapDn
        float tG = gapUp ? low[0]  : low[2]
        float bG = gapUp ? high[2] : high[0]
        float wG = tG - bG
        if wG >= storeNeedW
            box bxG = na
            if dgShowAll
                bxG := box.new(left = bar_index - 2, top = tG, right = bar_index, bottom = bG, xloc = xloc.bar_index, border_color = color.new(gapUp ? dgCBull : dgCBear, 100 - dgOp), bgcolor = na, border_width = dgBw, border_style = dgStyle)
            array.push(fvgArr, FvgZ.new(gapUp, tG, bG, wG, bar_index - 1, high[1], low[1], high[0], low[0], true, -1, na, na, na, bxG))
            while array.size(fvgArr) > fvgKeepEff
                FvgZ zd = array.shift(fvgArr)
                if not na(zd.bx)
                    box.delete(zd.bx)

// =====================================================================
//  MAY CISD -> su kien -> cay cuc tri -> cong quet -> DE RA CU CHO CA HAI
//  CO CHE. Hai co che duoc de ra DOC LAP: mot ben khong ra duoc thi ben kia
//  van ra binh thuong.
// =====================================================================
if anyMech and inWin and barstate.isconfirmed and bar_index >= 11
    if bias == 0
        int firstImpression = f_candleAttitude(0, 0)
        if firstImpression == 0
            for k = 1 to 50
                int att = f_candleAttitude(k, 0)
                if att != 0
                    firstImpression := att
                    break
        if firstImpression != 0
            bias := firstImpression
            [op, oi] = f_consultCrystalBall(firstImpression, 0)
            originPrice := op
            originIndex := oi
            extremeThreshold := firstImpression == 1 ? high[0] : low[0]
            initialized := true

    if initialized
        int candlePersonality = f_candleAttitude(0, 0)

        if bias == 1
            if high[0] > extremeThreshold
                extremeThreshold := high[0]
                float freshPrice = na
                int   freshIdx = na
                if candlePersonality == 1
                    [fp, fi] = f_consultCrystalBall(1, 0)
                    freshPrice := fp
                    freshIdx := fi
                else
                    [fp, fi] = f_archaeologistJones(1, 0)
                    freshPrice := fp
                    freshIdx := fi
                originPrice := freshPrice
                originIndex := freshIdx
        else if bias == -1
            if low[0] < extremeThreshold
                extremeThreshold := low[0]
                float freshPrice2 = na
                int   freshIdx2 = na
                if candlePersonality == -1
                    [fp2, fi2] = f_consultCrystalBall(-1, 0)
                    freshPrice2 := fp2
                    freshIdx2 := fi2
                else
                    [fp2, fi2] = f_archaeologistJones(-1, 0)
                    freshPrice2 := fp2
                    freshIdx2 := fi2
                originPrice := freshPrice2
                originIndex := freshIdx2

        bool shortsSqueezed = bias == -1 and close[0] > originPrice
        bool longsRekt      = bias == 1  and close[0] < originPrice

        if shortsSqueezed or longsRekt
            int   dir    = shortsSqueezed ? 1 : -1
            int   extAbs = f_findExtremeBar(dir, originIndex, bar_index, 0)
            int   eOff   = bar_index - extAbs
            float extPx  = dir == 1 ? low[eOff] : high[eOff]

            // Lop soi: cham MOI cuc tri, ke ca cai sap bi cong quet loai.
            if showExtDot and extDotAll
                array.push(extDots, label.new(x = extAbs, y = extPx, text = "•", xloc = xloc.bar_index, style = label.style_none, textcolor = color.new(extDotCol, 50), size = size.tiny))
                while array.size(extDots) > extDotKeep
                    label dDel = array.shift(extDots)
                    if not na(dDel)
                        label.delete(dDel)

            // Do MOT LAN roi moi co che tu quyet co dung hay khong — hai o
            // jdSweep / tsSweep hoan toan doc lap (owner chot 23-08).
            bool swept = f_swept(dir, extAbs, 0)

            if showExtDot and not extDotAll and swept
                array.push(extDots, label.new(x = extAbs, y = extPx, text = "•", xloc = xloc.bar_index, style = label.style_none, textcolor = color.new(extDotCol, 50), size = size.tiny))
                while array.size(extDots) > extDotKeep
                    label dDel2 = array.shift(extDots)
                    if not na(dDel2)
                        label.delete(dDel2)

            // ---------- CO CHE JUDAS: cong displacement RIENG ----------
            if enableJudas and (jdDir == 0 or jdDir == dir) and (not jdSweep or swept)
                int aM = f_ancMss(dir, extAbs, 0)
                if aM >= 0
                    int   oM  = bar_index - aM
                    float lvl = dir == 1 ? high[oM] : low[oM]
                    color cm  = f_mssCol(dir, false, mssDim)
                    // mssLen == 0 -> vach BO theo tung nen roi dung tai nen ra tin
                    // hieu; vong bao tri ghi de x2 ngay trong cung nen nay.
                    int   xE  = mssLen > 0 ? aM + mssLen : bar_index
                    // mssVis > 0 (MAC DINH 50) -> ve vach ngay tu day, soi duoc
                    // ca cu dang cho lan cu hong. Ha o ve 0 thi KHONG ve gi o
                    // day; vach sinh ra dung luc cu ra tin hieu, o duoi - khi do
                    // SO VACH = SO MUI TEN.
                    line  ln  = na
                    label lb  = na
                    if mssVis > 0
                        ln := line.new(x1 = aM, y1 = lvl, x2 = xE, y2 = lvl, xloc = xloc.bar_index, extend = extend.none, color = cm, style = mssStyle, width = mssW)
                        lb := label.new(x = aM, y = dir == 1 ? lvl + sAtr * mssTxtGap : lvl - sAtr * mssTxtGap, text = "MSS", xloc = xloc.bar_index, style = label.style_none, textcolor = cm, size = size.small)
                    array.push(jdArr, MechRec.new(dir, extAbs, extPx, aM, lvl, -1, false, false, ln, lb, na, na, na))
                    while array.size(jdArr) > jdKeep
                        MechRec rd = array.shift(jdArr)
                        // Cu DA RA TIN HIEU -> vach da sang tay jdSigArr, xoa o
                        // day la mui ten con ma vach mat (loi owner bao 24-08).
                        if not rd.done
                            f_killMech(rd)

            // ---------- CO CHE TURTLE SOUP: cong displacement RIENG ----------
            if enableTS and (tsDir == 0 or tsDir == dir) and (not tsSweep or swept)
                // ===== LUAT CAY NEO CISD (sua 23-08 toi, khop kent_combo_v9) =====
                // Vach CISD = originPrice: GIA MO cuc tri cua CHUOI nen cung
                // chieu bias CU — tuc la cay NGHICH MAU DAU TIEN cua chuoi
                // (dao len thi la cay GIAM cao nhat cua chuoi giam; dao xuong
                // thi la cay TANG thap nhat cua chuoi tang). Chinh may CISD o
                // tren da tinh san hai so nay de BAT su kien, khong tinh lai.
                //
                // BAN CU LAY SAI: f_ancCisd dem tu cay cuc tri sang trai roi
                // dung o cay nghich mau GAN NHAT — tuc cay CUOI chuoi, khong
                // phai cay dau. Ham do da GO HAN cung o `tsAncBack`.
                //
                // originPrice / originIndex o day VAN LA GIA TRI TRUOC KHI DAO:
                // khuc `bias := dir` nam BEN DUOI khoi nay.
                int aC = originIndex
                if aC >= 0
                    int   oC   = bar_index - aC
                    float lvl2 = originPrice
                    color cc   = f_cisdCol(dir, false, cisdDim)
                    // cisdLen == 0 -> nhu ben Judas, vach bo theo nen.
                    int   xE2  = cisdLen > 0 ? aC + cisdLen : bar_index
                    // SO VACH = SO TIN HIEU (owner chot 24-08) — y het ben Judas.
                    line  ln2  = na
                    if cisdVis > 0
                        ln2 := line.new(x1 = aC, y1 = lvl2, x2 = xE2, y2 = lvl2, xloc = xloc.bar_index, extend = extend.none, color = cc, style = cisdStyle, width = cisdW)
                    // Chu CISD dat NGAY TAI CAY NEO, luon nam NGOAI cay nen, phia doi
                    // dien voi huong gia sap di (owner chot 23-08):
                    //   cu BAN (cuc tri la dinh) -> duoi DAY cay neo, duoi duong ke
                    //   cu MUA (cuc tri la day)  -> tren DINH cay neo, tren duong ke
                    float cY   = dir == 1 ? high[oC] + sAtr * cisdTxtGap : low[oC] - sAtr * cisdTxtGap
                    label lb2  = na
                    if cisdVis > 0
                        lb2 := label.new(x = aC, y = cY, text = "CISD", xloc = xloc.bar_index, style = label.style_none, textcolor = cc, size = size.small)
                    array.push(tsArr, MechRec.new(dir, extAbs, extPx, aC, lvl2, -1, false, false, ln2, lb2, na, na, na))
                    while array.size(tsArr) > tsKeep
                        MechRec rd2 = array.shift(tsArr)
                        // Y het Judas: cu da ra tin hieu thi vach thuoc tsSigArr.
                        if not rd2.done
                            f_killMech(rd2)

            // ---------- Vach cuc tri CISD (chan doan chung) ----------
            // Ve cho MOI su kien CISD, khong con gac bang cong quet — no la
            // vach cua doan CISD chu khong thuoc co che nao.
            if cisdExtLineShow
                if not na(cisdCurExt)
                    f_retireExt(cisdCurExt, "CISD Max", cisdExtColOld, cisdOldExt, cisdExtKeepOld, bar_index)
                line  nl  = line.new(x1=extAbs, y1=extPx, x2=bar_index, y2=extPx, xloc=xloc.bar_index, extend=extend.none, color=cisdExtColCur, style=cisdExtStyleV, width=cisdExtWidth)
                label nlb = label.new(x=extAbs, y=extPx, text="CISD Max", xloc=xloc.bar_index, style=label.style_none, textcolor=cisdExtColCur, size=size.small)
                cisdCurExt := ExtLine.new(nl, nlb, dir, extPx, true)

            bias := dir
            [rp, ri] = f_consultCrystalBall(dir, 0)
            originPrice := rp
            originIndex := ri
            extremeThreshold := dir == 1 ? high[0] : low[0]

// #####################################################################
// #                                                                   #
// #   CO CHE ① : JUDAS — vach MSS + khe ho TUOI ben PHAI cuc tri      #
// #   Khong doc mot bien nao cua co che Turtle Soup.                  #
// #                                                                   #
// #####################################################################
if enableJudas and inWin and barstate.isconfirmed and array.size(jdArr) > 0
    for i = array.size(jdArr) - 1 to 0
        MechRec r = array.get(jdArr, i)
        // --- 1) vach MSS: keo dai + xet nen dong xuyen qua ---
        // O 'Vach MSS — dai (nen)' = 0 nghia la vach TU DUNG tai NEN RA
        // TIN HIEU: cu con song thi moi nen keo them mot cay, den luc
        // r.done thi thoi keo -> dau phai vach dung dung o mui ten.
        // Buoc keo dai phai chay TRUOC buoc tim khe ho ben duoi, nen
        // ngay chinh nen ra tin hieu vach van kip toi noi.
        if not na(r.ln) and mssLen == 0 and not r.done
            line.set_x2(r.ln, bar_index)
        // ⚠ KHUC DANH DAU 'DA XUYEN VACH' PHAI NAM NGOAI `if not na(r.ln)`.
        // Khi nguoi dung ha mssVis ve 0, vach chi sinh ra luc ra tin hieu nen
        // luc dang cho r.ln con na — de khuc nay ben trong la brkBar khong bao
        // gio duoc set, cong jdNeedMss khoa cung va KHONG CU NAO ra tin hieu.
        if r.brkBar < 0
            if (r.dir == 1 ? close > r.lvl : close < r.lvl)
                r.brkBar := bar_index
                if not na(r.ln)
                    color cOk = f_mssCol(r.dir, true, r.done ? 0 : mssDim)
                    line.set_color(r.ln, cOk)
                    if not na(r.lb)
                        label.set_textcolor(r.lb, cOk)
                // Vach vua duoc xac nhan -> hinh tin hieu da ban truoc do TU
                // SANG LEN du mau, khong ve lai gi.
                f_jdPaint(r)
        // --- 2) di tim khe ho TUOI thuan chieu DAT NGUONG CUA JUDAS, cay giua
        //        nam trong [cuc tri - 1 .. cuc tri - 2 + jdFvgWin] ---
        if not r.done and not r.dead
            // KHONG CON O HAN CHO nao: cua so FVG CHINH LA han (owner chot
            // 23-08 cuoi). Hai chan cu (chan ngoai / chan gat) da go han.
            // HET HAN = HET CUA SO FVG (owner chot 23-08 cuoi). Cua so keo tu
            // cay LIEN TRUOC cuc tri sang phai het jdFvgWin nen; cay giua cuoi
            // cung la extAbs - 2 + jdFvgWin, ma khe chi HOAN TAT o cay ngay sau
            // no -> song them dung mot nen nua roi chet. Qua do khong co FVG
            // nao dat -> XOA LUON VACH MSS (f_killMech o cuoi vong).
            if bar_index > r.extAbs - 1 + jdFvgWin
                r.dead := true
            else if not jdNeedMss or r.brkBar >= 0
                int loW = r.extAbs - 1
                int hiW = r.extAbs - 2 + jdFvgWin
                int pick = -1
                if array.size(fvgArr) > 0
                    for k = 0 to array.size(fvgArr) - 1
                        FvgZ z = array.get(fvgArr, k)
                        if z.alive and z.bull == (r.dir == 1) and z.midAbs >= loW and z.midAbs <= hiW and z.w >= jdNeedW
                            pick := k
                            break
                if pick >= 0
                    FvgZ  zf = array.get(fvgArr, pick)
                    color cJ = r.dir == 1 ? jdColBull : jdColBear
                    float aOff = sAtr * jdGap
                    // Cho dat dau, 3 lua chon. MAC DINH = CAY GIUA cua bo 3 nen —
                    // cay TAO RA khe ho (owner chot 23-08). Cay nay CO THE trung dung
                    // cay cuc tri, owner da xac nhan van nhan, khong loai.
                    int   mkAbs = jdMark == 2 ? r.extAbs : jdMark == 1 ? zf.midAbs : zf.midAbs + 1
                    float mkPx  = jdMark == 2 ? r.extPx : jdMark == 1 ? (r.dir == 1 ? zf.loM : zf.hiM) : (r.dir == 1 ? zf.lo3 : zf.hi3)
                    // RA NGOAI HOP (owner chot 23-08 cuoi): cay dat dau mac dinh nam
                    // dung trong be ngang cua hop khe ho, de nguyen thi mui ten va chu
                    // chim vao nen hop. Nam trong hop thi lay MEP HOP lam moc day ra.
                    if jdMark != 2 and mkAbs >= zf.midAbs - 1 and mkAbs <= zf.midAbs + 1
                        mkPx := r.dir == 1 ? math.min(mkPx, zf.btm) : math.max(mkPx, zf.top)
                    float mY    = r.dir == 1 ? mkPx - aOff : mkPx + aOff
                    string tx  = r.dir == 1 ? (jdShowTxt ? "▲\nJD" : "▲") : (jdShowTxt ? "JD\n▼" : "▼")
                    label lb   = label.new(x = mkAbs, y = mY, text = tx, xloc = xloc.bar_index, style = label.style_none, textcolor = cJ, size = jdTxSz)
                    line  st   = na
                    if jdStem and aOff != 0
                        st := line.new(mkAbs, mkPx, mkAbs, mY, xloc = xloc.bar_index, color = cJ, style = line.style_dotted, width = 1)
                    color cBx = zf.bull ? jdBoxBull : jdBoxBear
                    box bx = box.new(left = zf.midAbs - 1, top = zf.top, right = zf.midAbs + 1, bottom = zf.btm, xloc = xloc.bar_index, border_color = color.new(cBx, 100 - jdBoxOp), bgcolor = jdBoxFill > 0 ? color.new(cBx, 100 - jdBoxFill) : na, border_width = jdBoxW, border_style = jdBoxSty)
                    // VE VACH MSS DUNG BAY GIO neu chua ton tai (khi mssVis = 0).
                    // Tu cay neo toi nen ra tin hieu, ro 100%.
                    if na(r.ln)
                        color cmS = f_mssCol(r.dir, r.brkBar >= 0, 0)
                        int   xES = mssLen > 0 ? r.ancAbs + mssLen : bar_index
                        r.ln := line.new(x1 = r.ancAbs, y1 = r.lvl, x2 = xES, y2 = r.lvl, xloc = xloc.bar_index, extend = extend.none, color = cmS, style = mssStyle, width = mssW)
                        r.lb := label.new(x = r.ancAbs, y = r.dir == 1 ? r.lvl + sAtr * mssTxtGap : r.lvl - sAtr * mssTxtGap, text = "MSS", xloc = xloc.bar_index, style = label.style_none, textcolor = cmS, size = size.small)
                    f_pushSig(jdSigArr, lb, st, bx, r.ln, r.lb, jdKeep)
                    r.sLb := lb
                    r.sSt := st
                    r.sBx := bx
                    f_jdPaint(r)
                    r.done := true
                    alJd := true

                    // Ra tin hieu -> vach MSS het mo. KHONG dung toi vach CISD.
                    if not na(r.ln)
                        color cF = f_mssCol(r.dir, r.brkBar >= 0, 0)
                        line.set_color(r.ln, cF)
                        if not na(r.lb)
                            label.set_textcolor(r.lb, cF)
        // --- 3) cu hong -> xoa vach MSS. Vach CISD cua cu cung nen KHONG dinh ---
        if r.dead and not r.done
            f_killMech(r)

// #####################################################################
// #                                                                   #
// #   CO CHE ② : TURTLE SOUP — vach CISD + khe ho CU ben TRAI bi lap  #
// #   Khong doc mot bien nao cua co che Judas.                        #
// #                                                                   #
// #####################################################################
if enableTS and inWin and barstate.isconfirmed and array.size(tsArr) > 0
    for i2 = array.size(tsArr) - 1 to 0
        MechRec r2 = array.get(tsArr, i2)
        // --- 1) vach CISD: keo dai + chu bam dau phai + xet nen dong xuyen ---
        // Giong het Judas: o 'Vach CISD — dai (nen)' = 0 thi vach TU DUNG
        // tai NEN RA TIN HIEU. CHU CISD van bam CAY NEO, khong dong toi.
        if not na(r2.ln) and cisdLen == 0 and not r2.done
            line.set_x2(r2.ln, bar_index)
        // ⚠ Y het Judas: khuc danh dau 'da xuyen vach' NAM NGOAI `if not na`.
        if r2.brkBar < 0
            if (r2.dir == 1 ? close > r2.lvl : close < r2.lvl)
                r2.brkBar := bar_index
                if not na(r2.ln)
                    color cOk2 = f_cisdCol(r2.dir, true, r2.done ? 0 : cisdDim)
                    line.set_color(r2.ln, cOk2)
                    if not na(r2.lb)
                        label.set_textcolor(r2.lb, cOk2)
                // Vach vua duoc xac nhan -> hinh tin hieu TU SANG LEN du mau.
                f_tsPaint(r2)
        // --- 2) di tim khe ho NGUOC chieu DA BI LAP, DAT NGUONG CUA T.SOUP,
        //        cay giua nam trong [cuc tri - tsFvgWin + 1 .. cuc tri].
        //        LUAT CUNG: chinh nen lap phai dong cua xuyen qua vach CISD —
        //        khong co CISD thi khong phai Turtle Soup (owner chot 23-08).
        //        Trong so may cai hop le, lay cai BI LAP SOM NHAT. ---
        if not r2.done and not r2.dead
            // KHONG CON O HAN CHO nao, giong het Judas: cua so iFVG CHINH LA
            // han. Hai chan cu (chan ngoai / chan gat) da go han 23-08 cuoi.
            // HET HAN (owner chot 23-08 cuoi): iFVG cua Turtle Soup nam SAN ben
            // TRAI cuc tri roi, cai phai cho la NEN LAP. Cho dung tsFvgWin nen
            // ke tu cuc tri sang phai -- lay lai chinh con so cua so, khong de
            // mot o rieng. Qua do chua co khe nao bi lap -> XOA LUON VACH CISD.
            if bar_index > r2.extAbs + tsFvgWin
                r2.dead := true
            else
                // Owner 23-08: TINH CA cay cuc tri -> mep phai la extAbs, va
                // dung tsFvgWin nen ke ca no.
                int loW2 = r2.extAbs - tsFvgWin + 1
                int hiW2 = r2.extAbs
                int pick2 = -1
                int best  = -1
                if array.size(fvgArr) > 0
                    for k2 = 0 to array.size(fvgArr) - 1
                        FvgZ z2 = array.get(fvgArr, k2)
                        if z2.bull == (r2.dir == -1) and z2.midAbs >= loW2 and z2.midAbs <= hiW2 and z2.w >= tsNeedW and z2.fillAbs >= r2.extAbs
                            if not tsNeedCisd or (r2.dir == 1 ? z2.fillCls > r2.lvl : z2.fillCls < r2.lvl)
                                // --- NEW TS FILTER: FVG MUST BE FILLED BY AN OPPOSITE FVG ---
                                bool filledByOpposite = false
                                if tsNeedIfvg
                                    for kn = 0 to array.size(fvgArr) - 1
                                        FvgZ zn = array.get(fvgArr, kn)
                                        if zn.bull == (r2.dir == 1) and zn.midAbs > r2.extAbs
                                            if zn.btm <= z2.top and zn.top >= z2.btm
                                                filledByOpposite := true
                                                break
                                else
                                    filledByOpposite := true
                                if filledByOpposite
                                    if pick2 < 0 or z2.fillAbs < best
                                        best  := z2.fillAbs
                                        pick2 := k2
                if pick2 >= 0
                    FvgZ  zt = array.get(fvgArr, pick2)
                    color cT = r2.dir == 1 ? tsColBull : tsColBear
                    float aOff2 = sAtr * tsGap
                    // Cho dat dau, 3 lua chon. MAC DINH = CAY LAP khe ho.
                    int   mkAbs2 = tsMark == 2 ? r2.extAbs : tsMark == 1 ? zt.midAbs : zt.fillAbs
                    float mkPx2  = tsMark == 2 ? r2.extPx : tsMark == 1 ? (r2.dir == 1 ? zt.loM : zt.hiM) : (r2.dir == 1 ? zt.fillLo : zt.fillHi)
                    // RA NGOAI HOP (owner chot 23-08 cuoi: "chu TS hay bi lan trong
                    // box"). Hop TS keo tu cay 1 cua bo 3 nen toi dung NEN LAP, ma dau
                    // mac dinh dat o NEN LAP -> luon nam trong hop. Nam trong hop thi
                    // lay MEP HOP lam moc day ra, khong lay dinh/day cay nen.
                    if tsMark != 2 and mkAbs2 >= zt.midAbs - 1 and mkAbs2 <= math.max(zt.fillAbs, zt.midAbs + 1)
                        mkPx2 := r2.dir == 1 ? math.min(mkPx2, zt.btm) : math.max(mkPx2, zt.top)
                    float mY2    = r2.dir == 1 ? mkPx2 - aOff2 : mkPx2 + aOff2
                    string tx2  = r2.dir == 1 ? (tsShowTxt ? "▲\nTS" : "▲") : (tsShowTxt ? "TS\n▼" : "▼")
                    label lbT   = label.new(x = mkAbs2, y = mY2, text = tx2, xloc = xloc.bar_index, style = label.style_none, textcolor = cT, size = tsTxSz)
                    line  stT   = na
                    if tsStem and aOff2 != 0
                        stT := line.new(mkAbs2, mkPx2, mkAbs2, mY2, xloc = xloc.bar_index, color = cT, style = line.style_dotted, width = 1)
                    // Hop KEO DAI tu cay 1 cua bo 3 nen (luc khe SINH RA) toi dung
                    // NEN LAP (luc khe CHET) — owner chot 23-08. Nho vay hop tu no
                    // noi lien cho sinh voi cho vao lenh, khong can doc vach noi.
                    color cBxT = zt.bull ? tsBoxBull : tsBoxBear
                    box bxT = box.new(left = zt.midAbs - 1, top = zt.top, right = math.max(zt.fillAbs, zt.midAbs + 1), bottom = zt.btm, xloc = xloc.bar_index, border_color = color.new(cBxT, 100 - tsBoxOp), bgcolor = tsBoxFill > 0 ? color.new(cBxT, 100 - tsBoxFill) : na, border_width = tsBoxW, border_style = tsBoxSty)
                    // VE VACH CISD DUNG BAY GIO neu chua ton tai (khi cisdVis = 0).
                    if na(r2.ln)
                        color ccS = f_cisdCol(r2.dir, r2.brkBar >= 0, 0)
                        int   oCS = bar_index - r2.ancAbs
                        int   xES2 = cisdLen > 0 ? r2.ancAbs + cisdLen : bar_index
                        r2.ln := line.new(x1 = r2.ancAbs, y1 = r2.lvl, x2 = xES2, y2 = r2.lvl, xloc = xloc.bar_index, extend = extend.none, color = ccS, style = cisdStyle, width = cisdW)
                        r2.lb := label.new(x = r2.ancAbs, y = r2.dir == 1 ? high[oCS] + sAtr * cisdTxtGap : low[oCS] - sAtr * cisdTxtGap, text = "CISD", xloc = xloc.bar_index, style = label.style_none, textcolor = ccS, size = size.small)
                    f_pushSig(tsSigArr, lbT, stT, bxT, r2.ln, r2.lb, tsKeep)
                    r2.sLb := lbT
                    r2.sSt := stT
                    r2.sBx := bxT
                    f_tsPaint(r2)
                    r2.done := true
                    alTs := true

                    // Ra tin hieu -> vach CISD het mo. KHONG dung toi vach MSS.
                    if not na(r2.ln)
                        color cF2 = f_cisdCol(r2.dir, r2.brkBar >= 0, 0)
                        line.set_color(r2.ln, cF2)
                        if not na(r2.lb)
                            label.set_textcolor(r2.lb, cF2)
        // --- 3) cu hong -> xoa vach CISD. Vach MSS cua cu cung nen KHONG dinh ---
        if r2.dead and not r2.done
            f_killMech(r2)

// =====================================================================
//  VACH CUC TRI CISD (chan doan chung): keo dai + xet pha vo. Nguyen van
//  kent_combo_v9, tru viec RETIRE chi lam khi NEN DONG (Pine khong rollback
//  MANG tren nen realtime).
// =====================================================================
if not na(cisdCurExt)
    if not cisdExtLineShow
        if not na(cisdCurExt.ln)
            line.delete(cisdCurExt.ln)
        if not na(cisdCurExt.lb)
            label.delete(cisdCurExt.lb)
        cisdCurExt := na
    else if cisdCurExt.active
        if not na(cisdCurExt.ln)
            line.set_x2(cisdCurExt.ln, bar_index)
        if barstate.isconfirmed
            if (cisdCurExt.dir == 1 ? close < cisdCurExt.px : close > cisdCurExt.px)
                f_retireExt(cisdCurExt, "CISD Max", cisdExtColOld, cisdOldExt, cisdExtKeepOld, bar_index)
                cisdCurExt := na

// =====================================================================
//  ALERT — de NGOAI than ham: Pine chan mot so ham co tac dung phu trong
//  local scope. Hai o alert TACH RIENG theo tung co che.
// =====================================================================
if (jdAlert and alJd) or (tsAlert and alTs)
    bool bJ = jdAlert and alJd
    bool bT = tsAlert and alTs
    string aMsg = bJ and bT ? "JD + TS" : bJ ? "JD" : "TS"
    alert("2TC-v10 [" + syminfo.ticker + " " + timeframe.period + "]: " + aMsg + " moi", alert.freq_once_per_bar_close)
alertcondition(alJd,           title = "JD moi",           message = "2TC-v10: co tin hieu Judas moi")
alertcondition(alTs,           title = "TS moi",           message = "2TC-v10: co tin hieu Turtle Soup moi")
alertcondition(alJd or alTs,   title = "JD hoac TS moi",   message = "2TC-v10: co JD hoac TS moi")

// #####################################################################
// #   CUM CRB (Sweep & Engulf) — NGUYEN VAN tu CRB-Model.pine          #
// #####################################################################
//  SWEEP & ENGULF + FVG (Pyramiding CRB0..CRBn)  — MPL-2.0, merge boi Neiro
//  Tin hieu Sweep+Engulf 2 nen + FVG nen C -> danh so CRB0/CRB1*..., SL chung
//  chuoi, phu nen bo nen A&B, alert dong. Bien 'atr' -> 'se_atr' (tranh BigBeluga).

// =====================================================================
// NHOM 13 - FVG MULTI-TIMEFRAME (độc lập, không filter)
gFM = "11 · FVG MULTI-TIMEFRAME"
fvgOn    = input.bool(true, "Bật FVG MTF", group = gFM)
fvgN     = input.int(100, "Number of FVGs", minval = 1, maxval = 120, inline = "f0", group = gFM)
htfStyS  = input.string("dashed", "HTF FVG Style", options = ["solid", "dashed", "dotted"], inline = "f0", group = gFM)
extOn    = input.bool(false, "Kéo dài FVG đến khi bị lấp", group = gFM, tooltip = "Tắt: chỉ vẽ vùng FVG từ nến 1 đến nến 3. Bật: kéo dài vùng sang phải đến khi giá lấp hết FVG.")
hideFill = input.bool(false, "Ẩn FVG đã lấp", group = gFM)
ctfOn    = input.bool(false, "ChartTF FVG", inline = "ctf", group = gFM)
bullClr  = input.color(color.new(color.green, 70),  "BullFVG Clr", inline = "ctf", group = gFM)
bearClr  = input.color(color.new(color.orange, 70), "BearFVG Clr", inline = "ctf", group = gFM)

h1On  = input.bool(false, "HTF-1", inline = "h1", group = gFM)
h1Tf  = input.timeframe("15", "", inline = "h1", group = gFM)
h1Clr = input.color(color.gray, "BorderClr", inline = "h1", group = gFM)
h1W   = input.int(1, "Width", minval = 1, maxval = 5, inline = "h1", group = gFM)
h2On  = input.bool(false, "HTF-2", inline = "h2", group = gFM)
h2Tf  = input.timeframe("60", "", inline = "h2", group = gFM)
h2Clr = input.color(color.gray, "BorderClr", inline = "h2", group = gFM)
h2W   = input.int(1, "Width", minval = 1, maxval = 5, inline = "h2", group = gFM)
h3On  = input.bool(false, "HTF-3", inline = "h3", group = gFM)
h3Tf  = input.timeframe("240", "", inline = "h3", group = gFM)
h3Clr = input.color(color.gray, "BorderClr", inline = "h3", group = gFM)
h3W   = input.int(1, "Width", minval = 1, maxval = 5, inline = "h3", group = gFM)

htfSty = htfStyS == "solid" ? line.style_solid : htfStyS == "dotted" ? line.style_dotted : line.style_dashed

type MtfFvg
    box   b
    float top
    float bot
    int   dir
    bool  done

var array<MtfFvg> zC = array.new<MtfFvg>()
var array<MtfFvg> z1 = array.new<MtfFvg>()
var array<MtfFvg> z2 = array.new<MtfFvg>()
var array<MtfFvg> z3 = array.new<MtfFvg>()

addZone(array<MtfFvg> arr, MtfFvg z, int maxN) =>
    arr.push(z)
    if arr.size() > maxN
        MtfFvg old = arr.shift()
        old.b.delete()

updZones(array<MtfFvg> arr, bool hide, bool useTime, bool ext) =>
    if arr.size() > 0
        for i = arr.size() - 1 to 0
            MtfFvg z = arr.get(i)
            if not z.done
                if ext
                    if useTime
                        z.b.set_right(time)
                    else
                        z.b.set_right(bar_index)
                bool filled = z.dir == 1 ? low <= z.bot : high >= z.top
                if filled
                    z.done := true
                    if hide
                        z.b.delete()
                        arr.remove(i)

tfTxt(string tf) =>
    int s = timeframe.in_seconds(tf)
    s < 3600 ? str.tostring(math.round(s / 60)) + "m" : s < 86400 ? str.tostring(math.round(s / 3600)) + "h" : tf

validTf(string tf) => timeframe.in_seconds(tf) > timeframe.in_seconds(timeframe.period)

// Dữ liệu HTF: chỉ lấy nến HTF đã đóng (không repaint)
[a_h3, a_l3, a_h1, a_l1, a_t1, a_t3, a_tc] = request.security(syminfo.tickerid, h1Tf, [high[1], low[1], high[3], low[3], time[3], time[1], time_close[1]], lookahead = barmerge.lookahead_on)
[b_h3, b_l3, b_h1, b_l1, b_t1, b_t3, b_tc] = request.security(syminfo.tickerid, h2Tf, [high[1], low[1], high[3], low[3], time[3], time[1], time_close[1]], lookahead = barmerge.lookahead_on)
[c_h3, c_l3, c_h1, c_l1, c_t1, c_t3, c_tc] = request.security(syminfo.tickerid, h3Tf, [high[1], low[1], high[3], low[3], time[3], time[1], time_close[1]], lookahead = barmerge.lookahead_on)
newA = a_t3 != a_t3[1]
newB = b_t3 != b_t3[1]
newC = c_t3 != c_t3[1]

newHtf(array<MtfFvg> arr, bool isNew, float h3, float l3, float h1, float l1, int t1, int tc, string tf, color bc, int w, int maxN) =>
    if isNew and not na(h1)
        if l3 > h1
            addZone(arr, MtfFvg.new(box.new(t1, l3, extOn ? time : tc, h1, xloc = xloc.bar_time, border_color = bc, border_width = w, border_style = htfSty, bgcolor = color(na), text = tfTxt(tf), text_size = size.tiny, text_color = bc, text_halign = text.align_right, text_valign = text.align_top), l3, h1, 1, false), maxN)
        else if h3 < l1
            addZone(arr, MtfFvg.new(box.new(t1, l1, extOn ? time : tc, h3, xloc = xloc.bar_time, border_color = bc, border_width = w, border_style = htfSty, bgcolor = color(na), text = tfTxt(tf), text_size = size.tiny, text_color = bc, text_halign = text.align_right, text_valign = text.align_bottom), l1, h3, -1, false), maxN)

if fvgOn and barstate.isconfirmed
    // cập nhật (kéo dài / đánh dấu lấp) trước khi thêm FVG mới
    updZones(zC, hideFill, false, extOn)
    updZones(z1, hideFill, true, extOn)
    updZones(z2, hideFill, true, extOn)
    updZones(z3, hideFill, true, extOn)

    if ctfOn
        if low > high[2]
            addZone(zC, MtfFvg.new(box.new(bar_index - 2, low, bar_index, high[2], border_color = color(na), bgcolor = bullClr), low, high[2], 1, false), fvgN)
        else if high < low[2]
            addZone(zC, MtfFvg.new(box.new(bar_index - 2, low[2], bar_index, high, border_color = color(na), bgcolor = bearClr), low[2], high, -1, false), fvgN)

    if h1On and validTf(h1Tf)
        newHtf(z1, newA, a_h3, a_l3, a_h1, a_l1, a_t1, a_tc, h1Tf, h1Clr, h1W, fvgN)
    if h2On and validTf(h2Tf)
        newHtf(z2, newB, b_h3, b_l3, b_h1, b_l1, b_t1, b_tc, h2Tf, h2Clr, h2W, fvgN)
    if h3On and validTf(h3Tf)
        newHtf(z3, newC, c_h3, c_l3, c_h1, c_l1, c_t1, c_tc, h3Tf, h3Clr, h3W, fvgN)

// =====================================================================
// 10 · GANN SWING CONSOLIDATION [F0-F1-SF1]
// =====================================================================
// SERIES DÙNG CHUNG
// =====================================================================
atrV   = ta.atr(atrLen)
volSma = ta.sma(volume, volLen)

// =====================================================================
// ENGINE GANN: F0 → F1 → SF1 (port nguyên logic gốc, X = bar_index)
// =====================================================================
var f0x    = array.new_int(5, 0)
var f0y    = array.new_float(5, close)
var f1x    = array.new_int(5, 0)
var f1y    = array.new_float(5, close)
var sfx    = array.new_int(5, 0)
var sfy    = array.new_float(5, close)
var sfMark = array.new_float(1, 0.0)   // > 0 : SF1 đang Pending (nhịp điều chỉnh)
var sfPend = array.new_int(1, 0)       // bar_index của cực trị S1 lúc vào Pending
var lnF1   = array.new_line(1)
var lnSF   = array.new_line(1)

f_cap(array<int> ax, array<float> ay, int cap) =>
    if ax.size() > cap
        ax.pop()
        ay.pop()

// F1 Gann — kết quả 1: điểm mới (đảo chiều) · 2: kéo dài cực trị · 0: không đổi
f_calcF1(int px, float py) =>
    int r = 0
    float a0 = f1y.get(0)
    float a1 = f1y.get(1)
    float n0 = f0y.get(0)
    float n1 = f0y.get(1)
    float n2 = f0y.get(2)
    float n3 = f0y.get(3)
    if (a0 >= a1 and n0 < a1) or (a0 <= a1 and n0 > a1)
        f1x.unshift(px)
        f1y.unshift(py)
        r := 1
    else if a0 >= a1 and n0 < n1 and n0 < n2 and n1 < n3 and n2 < n3
        f1x.unshift(px)
        f1y.unshift(py)
        r := 1
    else if a0 <= a1 and n0 > n1 and n0 > n2 and n1 > n3 and n2 > n3
        f1x.unshift(px)
        f1y.unshift(py)
        r := 1
    else if a0 >= a1 and py >= a0
        f1x.set(0, px)
        f1y.set(0, py)
        r := 2
    else if a0 <= a1 and py <= a0
        f1x.set(0, px)
        f1y.set(0, py)
        r := 2
    f_cap(f1x, f1y, 60)
    r

// SF1 Gann — máy trạng thái Normal / Pending
f_calcSF1(int px, float py) =>
    int r = 0
    float m  = sfMark.get(0)
    float s0 = sfy.get(0)
    float s1 = sfy.get(1)
    float s2 = sfy.get(2)
    bool up = s0 >= s1
    bool dn = s0 <= s1
    if m == 0
        if (up and py >= s0) or (dn and py <= s0)
            sfx.set(0, px)
            sfy.set(0, py)
            r := 2
        else if (up and py < s1) or (dn and py > s1)
            sfx.unshift(px)
            sfy.unshift(py)
            r := 1
        else if (up and py < s0 and py > s1) or (dn and py > s0 and py < s1)
            sfx.unshift(px)
            sfy.unshift(py)
            sfMark.set(0, py)
            sfPend.set(0, sfx.get(1))
            r := 1
    else if m > 0
        if (up and py < s1) or (dn and py > s1)
            sfx.unshift(px)
            sfy.unshift(py)
            sfMark.set(0, 0.0)
            r := 1
        else if (up and py > s2) or (dn and py < s2)
            sfx.set(0, px)
            sfy.set(0, py)
            sfMark.set(0, 0.0)
            r := 2
        else if (up and py <= s2 and py >= s0) or (dn and py >= s2 and py <= s0)
            sfx.set(0, px)
            sfy.set(0, py)
            sfMark.set(0, py)
            r := 2
    f_cap(sfx, sfy, 60)
    r

f_point(int px, float py) =>
    f0x.unshift(px)
    f0y.unshift(py)
    f_cap(f0x, f0y, 10)
    int d1 = f_calcF1(px, py)
    if d1 > 0
        if showF1
            if d1 == 1
                lnF1.set(0, line.new(f1x.get(1), f1y.get(1), f1x.get(0), f1y.get(0), color = cF1, style = line.style_dotted))
            else if not na(lnF1.get(0))
                line.set_xy2(lnF1.get(0), f1x.get(0), f1y.get(0))
        int ds = f_calcSF1(px, py)
        if ds > 0 and showSF
            if ds == 1
                lnSF.set(0, line.new(sfx.get(1), sfy.get(1), sfx.get(0), sfy.get(0), color = cSF))
            else if not na(lnSF.get(0))
                line.set_xy2(lnSF.get(0), sfx.get(0), sfy.get(0))
    d1

f_feed(float y1, float y2) =>
    float last = f0y.get(0)
    if (last > y1 and last > y2) or (last < y1 and last < y2)
        f_point(bar_index, f0y.get(1))
    f_point(bar_index, y1)
    f_point(bar_index, y2)

// Tham chiếu nến trước (inside bar giữ High/Low nến mẹ)
float p_high = useClosePiv ? math.max(open, close) : high
float p_low  = useClosePiv ? math.min(open, close) : low

float gs_highPrev = p_high
float gs_lowPrev  = p_low
bool isIB = not na(gs_highPrev[1]) and p_high <= gs_highPrev[1] and p_low >= gs_lowPrev[1]
if isIB
    gs_highPrev := gs_highPrev[1]
    gs_lowPrev  := gs_lowPrev[1]

if barstate.isconfirmed and not na(gs_highPrev[1])
    float hp = gs_highPrev[1]
    float lp = gs_lowPrev[1]
    if p_high > hp and p_low > lp
        f_feed(p_low, p_high)
    else if p_high < hp and p_low < lp
        f_feed(p_high, p_low)
    else if (p_high >= hp and p_low < lp) or (p_high > hp and p_low <= lp)
        if close > open
            f_feed(p_low, p_high)
        else
            f_feed(p_high, p_low)

// Xu hướng SF1 trước vùng: Pending → hướng chân S2→S1, Normal → hướng chân hiện tại
f_trend() =>
    sfMark.get(0) > 0 ? (sfy.get(1) > sfy.get(2) ? 1 : -1) : (sfy.get(0) >= sfy.get(1) ? 1 : -1)

// =====================================================================
// PHÁT HIỆN ỨNG VIÊN
// =====================================================================
// Cách A / B: dùng các điểm swing đã xác nhận (index ≥ 1)
f_candPiv(bool en, bool useSF, int minX) =>
    bool  ok = false
    int   oL = na
    float oT = na
    float oB = na
    float oIT = na
    float oIB = na
    if en
        array<int>   xs = useSF ? sfx : f1x
        array<float> ys = useSF ? sfy : f1y
        int kMax = math.min(ys.size() - 1, maxPiv)
        int kMin = minTouch * 2
        float lim = maxAtr * atrV
        if kMax >= kMin
            for k = kMax to kMin
                int lx = xs.get(k)
                if lx < minX or bar_index - lx + 1 < minBars or bar_index - lx > 900
                    continue
                float t = ys.get(1)
                float b = ys.get(1)
                for j = 2 to k
                    t := math.max(t, ys.get(j))
                    b := math.min(b, ys.get(j))
                float h = t - b
                if h <= 0 or h > lim or close > t or close < b
                    continue
                float tv = h * tolPct / 100
                int nt = 0
                int nb = 0
                float st = 0.0
                float sb = 0.0
                for j = 1 to k
                    float v = ys.get(j)
                    if v >= t - tv
                        nt += 1
                        st += v
                    else if v <= b + tv
                        nb += 1
                        sb += v
                if nt >= minTouch and nb >= minTouch
                    ok  := true
                    oL  := lx
                    oT  := t
                    oB  := b
                    oIT := st / nt
                    oIB := sb / nb
                    break
    [ok, oL, oT, oB, oIT, oIB]

// Cách C: cửa sổ nến dài nhất có biên độ ≤ giới hạn, đếm lượt chạm xen kẽ (bỏ inside bar)
f_candC(bool en) =>
    bool  ok = false
    int   oL = na
    float oT = na
    float oB = na
    float oIT = na
    float oIB = na
    if en
        float lim = maxAtr * atrV
        float hi = high
        float lo = low
        int L = 1
        int look = math.min(maxLook, bar_index)
        if look > 1
            for j = 1 to look - 1
                float nh = math.max(hi, high[j])
                float nl = math.min(lo, low[j])
                if nh - nl > lim
                    break
                hi := nh
                lo := nl
                L  := j + 1
        if L >= minBars and hi > lo
            float tv = (hi - lo) * tolPct / 100
            int last = 0
            int nt = 0
            int nb = 0
            float st = 0.0
            float sb = 0.0
            for j = L - 1 to 0
                if not isIB[j]
                    if high[j] >= hi - tv and last != 1
                        nt += 1
                        st += high[j]
                        last := 1
                    else if low[j] <= lo + tv and last != -1
                        nb += 1
                        sb += low[j]
                        last := -1
            if nt >= minTouch and nb >= minTouch
                ok  := true
                oL  := bar_index - L + 1
                oT  := hi
                oB  := lo
                oIT := st / nt
                oIB := sb / nb
    [ok, oL, oT, oB, oIT, oIB]

// Bộ lọc kiểu C cho Cách A/B
f_cFilter(int left, float it, float ib) =>
    int span = bar_index - left + 1
    int inC = 0
    int nIB = 0
    for j = 0 to span - 1
        if close[j] <= it and close[j] >= ib
            inC += 1
        if isIB[j]
            nIB += 1
    inC * 100.0 / span >= cfClose and nIB * 100.0 / span >= cfIB

// =====================================================================
// HỘP CONSOLIDATION
// =====================================================================
type CBox
    int   left
    float top
    float bot
    float inTop
    float inBot
    int   trend
    int   state  = 1      // 1: đang sống · 2: đã phá, chờ BTR · 3: kết thúc
    int   endBar
    int   brBar           // nến 2 của bộ FVG phá
    int   brDir
    float fvgFar          // mép xa FVG: Buy = High nến 1, Sell = Low nến 1
    bool  szOk   = true
    bool  btrHit = false
    int   btrBar
    int   btrDir
    box   bxO
    box   bxI
    label lbBO
    label lbBTR

var boxes = array.new<CBox>()

f_setRight(CBox b, int r) =>
    if not na(b.bxO)
        box.set_right(b.bxO, r)
    if not na(b.bxI)
        box.set_right(b.bxI, r)

f_mkBoxes(int l, float t, float b, float it, float ib) =>
    box bo = na
    box bi = na
    if drawMode != DM_IN
        bo := box.new(l, t, bar_index, b, border_color = cBorder, bgcolor = cFill, border_width = 1)
    if drawMode != DM_OUT
        bi := box.new(l, it, bar_index, ib, border_color = cInner, bgcolor = drawMode == DM_IN ? cFill : color.new(color.white, 100), border_width = 1, border_style = line.style_dashed)
    [bo, bi]

f_lbl(int x, int d, string txt, color col, string sz) =>
    label.new(x, close, txt, yloc = d == 1 ? yloc.belowbar : yloc.abovebar, style = d == 1 ? label.style_label_up : label.style_label_down, color = col, textcolor = color.white, size = sz,
         tooltip = "TD = tiếp diễn xu hướng SF1 · ĐC = đảo chiều")

f_tag(int d, int trend) =>
    sfTagOn ? (d == trend ? " TD" : " ĐC") : ""

// Cờ sự kiện cho alert
bool evDet  = false
bool evBO   = false
bool evBAG  = false
bool evBTR  = false
bool evBTRs = false
bool evEnd  = false
string msg  = ""

// ---------------------------------------------------------------------
// 1) CẬP NHẬT CÁC HỘP (xét nến c = nến trước, nến hiện tại là nến 3 của FVG)
// ---------------------------------------------------------------------
if barstate.isconfirmed and boxes.size() > 0
    for i = boxes.size() - 1 to 0
        CBox b = boxes.get(i)
        int c = bar_index - 1

        // Nâng cấp BTR → BTR* (nến invert là nến 2 của FVG ngược chiều)
        if not na(b.btrBar) and bar_index == b.btrBar + 1
            bool star = b.btrDir == -1 ? high < low[2] : low > high[2]
            if star
                if not na(b.lbBTR)
                    label.set_text(b.lbBTR, "BTR*")
                    label.set_color(b.lbBTR, b.btrDir == 1 ? cBTRsBuy : cBTRsSell)
                    label.set_size(b.lbBTR, size.normal)
                evBTRs := true
                msg += "BTR* " + (b.btrDir == 1 ? "BUY" : "SELL") + " | "

        if b.state == 1
            float brT = brkMode == DM_IN ? b.inTop : b.top
            float brB = brkMode == DM_IN ? b.inBot : b.bot
            float gUp = low - high[2]
            float gDn = low[2] - high
            float refA = atrV[2]
            bool okUp = not szOn or gUp >= szMult * refA
            bool okDn = not szOn or gDn >= szMult * refA
            bool blkA = szOn and szMode == MODE_A
            bool boUp = c > b.left and close[1] > brT and gUp > 0 and (not blkA or okUp)
            bool boDn = c > b.left and close[1] < brB and gDn > 0 and (not blkA or okDn)
            if boUp or boDn
                int d = boUp ? 1 : -1
                b.state  := 2
                b.brBar  := c
                b.brDir  := d
                b.fvgFar := boUp ? high[2] : low[2]
                b.szOk   := boUp ? okUp : okDn
                b.btrHit := false
                f_setRight(b, c)
                if sigOn
                    b.lbBO := f_lbl(c, d, "B/O" + f_tag(d, b.trend), d == 1 ? cBOBuy : cBOSell, size.small)
                evBO  := true
                evEnd := true
                msg += "B/O " + (d == 1 ? "BUY" : "SELL") + f_tag(d, b.trend) + " | "
            else
                float h1 = high[1]
                float l1 = low[1]
                if h1 > b.top or l1 < b.bot
                    float nt = math.max(b.top, h1)
                    float nb = math.min(b.bot, l1)
                    if nt - nb <= maxAtr * atrV
                        // Giãn hộp (vượt biên nhưng không có FVG, vẫn trong giới hạn ATR)
                        b.top := nt
                        b.bot := nb
                        if not na(b.bxO)
                            box.set_top(b.bxO, nt)
                            box.set_bottom(b.bxO, nb)
                        f_setRight(b, bar_index)
                    else
                        // Trôi ra quá giới hạn mà không có FVG → kết thúc im lặng
                        b.state  := 3
                        b.endBar := math.max(b.left, c - 1)
                        f_setRight(b, b.endBar)
                        evEnd := true
                        msg += "Consolidation Ended | "
                else
                    f_setRight(b, bar_index)

        else if b.state == 2
            int k = bar_index - b.brBar
            int d = b.brDir
            // Nâng cấp B/O → BAG khi nến 4 đóng
            if k == 2
                float r2  = high[2] - low[2]
                float bd2 = math.abs(close[2] - open[2])
                float ps2 = r2 > 0 ? (d == 1 ? (close[2] - low[2]) / r2 : (high[2] - close[2]) / r2) : 0.0
                bool disp = r2 > 0 and bd2 / r2 >= dBody and ps2 >= dClose and r2 >= dAtr * atrV[3] and (not volOn or volume[2] >= volMult * volSma[3])
                bool c4   = d == 1 ? low > low[1] : high < high[1]
                bool szB  = not (szOn and szMode == MODE_B) or b.szOk
                if disp and c4 and szB
                    if not na(b.lbBO)
                        label.set_text(b.lbBO, "BAG" + f_tag(d, b.trend))
                        label.set_color(b.lbBO, d == 1 ? cBAGBuy : cBAGSell)
                        label.set_size(b.lbBO, size.normal)
                    evBAG := true
                    msg += "BAG " + (d == 1 ? "BUY" : "SELL") + f_tag(d, b.trend) + " | "
            // BTR: FVG phá bị invert (close vượt mép xa) trong N nến
            if k >= 1 and k <= btrN and not b.btrHit
                bool inv = d == 1 ? close < b.fvgFar : close > b.fvgFar
                if inv
                    b.btrHit := true
                    b.btrBar := bar_index
                    b.btrDir := -d
                    if btrOn
                        label.delete(b.lbBO)
                        b.lbBO  := na
                        b.lbBTR := f_lbl(bar_index, -d, "BTR", -d == 1 ? cBTRBuy : cBTRSell, size.small)
                    evBTR := true
                    msg += "BTR " + (-d == 1 ? "BUY" : "SELL") + " | "
                    if close <= b.top and close >= b.bot
                        // Giá đóng lại vào trong hộp → hộp sống lại (lần phá vừa rồi là phá giả)
                        b.state := 1
                        f_setRight(b, bar_index)
                    else
                        b.state  := 3
                        b.endBar := b.brBar
            if b.state == 2 and k >= math.max(btrN, 2)
                b.state  := 3
                b.endBar := b.brBar

    // Dọn bớt hộp đã kết thúc (giữ tối đa 40 hộp gần nhất để chống vẽ lại)
    int n3 = 0
    for b in boxes
        if b.state == 3
            n3 += 1
    if n3 > 40
        for i = 0 to boxes.size() - 1
            if boxes.get(i).state == 3
                boxes.remove(i)
                break

// ---------------------------------------------------------------------
// 2) PHÁT HIỆN VÙNG MỚI
// ---------------------------------------------------------------------
if barstate.isconfirmed and not na(atrV) and bar_index > 5
    bool useC  = method == M_C
    bool useB  = method == M_B
    bool pendB = sfMark.get(0) > 0
    [pO, pL, pT, pB, pIT, pIB] = f_candPiv(not useC and (not useB or pendB), method == M_A and layer == "SF1", useB ? sfPend.get(0) : 0)
    [qO, qL, qT, qB, qIT, qIB] = f_candC(useC)
    bool  ok  = useC ? qO : pO
    int   cL  = useC ? qL : pL
    float cT  = useC ? qT : pT
    float cB  = useC ? qB : pB
    float cIT = useC ? qIT : pIT
    float cIB = useC ? qIB : pIB

    if ok and cfOn and not useC
        ok := f_cFilter(cL, cIT, cIB)

    if ok
        float eps = syminfo.mintick
        bool skip = false
        array<int> covIdx = array.new_int()
        if boxes.size() > 0
            for i = 0 to boxes.size() - 1
                CBox b = boxes.get(i)
                if b.state == 1
                    bool inside = cT <= b.top + eps and cB >= b.bot - eps
                    bool covers = cT >= b.top - eps and cB <= b.bot + eps
                    if ovMode == OV_B
                        skip := true
                    else if ovMode == OV_C and covers
                        covIdx.push(i)
                    else if inside
                        skip := true
                    else if covers
                        bool bigger = cT > b.top + eps or cB < b.bot - eps
                        if not bigger
                            skip := true
                else
                    // Vùng mới phải bắt đầu sau khi vùng cũ (cùng khu vực giá) đã bị phá / kết thúc
                    int eX = b.state == 2 ? b.brBar : b.endBar
                    if cL <= eX and cT > b.bot and cB < b.top
                        skip := true

        if not skip
            if covIdx.size() > 0
                // (c) Vùng lớn nuốt vùng nhỏ: gộp vào hộp đầu tiên, xóa các hộp nhỏ còn lại
                CBox t0 = boxes.get(covIdx.get(0))
                t0.left  := math.min(t0.left, cL)
                t0.top   := cT
                t0.bot   := cB
                t0.inTop := cIT
                t0.inBot := cIB
                if not na(t0.bxO)
                    box.set_left(t0.bxO, t0.left)
                    box.set_top(t0.bxO, cT)
                    box.set_bottom(t0.bxO, cB)
                if not na(t0.bxI)
                    box.set_left(t0.bxI, t0.left)
                    box.set_top(t0.bxI, cIT)
                    box.set_bottom(t0.bxI, cIB)
                if covIdx.size() > 1
                    for j = covIdx.size() - 1 to 1
                        int idx = covIdx.get(j)
                        CBox bd = boxes.get(idx)
                        box.delete(bd.bxO)
                        box.delete(bd.bxI)
                        boxes.remove(idx)
            else
                CBox nbx = CBox.new(left = cL, top = cT, bot = cB, inTop = cIT, inBot = cIB, trend = f_trend())
                [bo, bi] = f_mkBoxes(cL, cT, cB, cIT, cIB)
                nbx.bxO := bo
                nbx.bxI := bi
                boxes.push(nbx)
                evDet := true
                msg += "Consolidation Detected | "

// =====================================================================
// ALERTS
// =====================================================================
alertcondition(evDet,  "Consolidation Detected", "Phát hiện vùng Consolidation mới")
alertcondition(evEnd,  "Consolidation Ended",    "Vùng Consolidation kết thúc (B/O hoặc trôi ra)")
alertcondition(evBO,   "B/O",  "Phá hộp Consolidation bằng FVG (B/O)")
alertcondition(evBAG,  "BAG",  "Phá hộp nâng cao (BAG)")
alertcondition(evBTR,  "BTR",  "Phá giả — FVG phá bị invert (BTR)")
alertcondition(evBTRs, "BTR*", "Phá giả mạnh — invert tạo FVG ngược chiều (BTR*)")
if msg != ""
    alert(syminfo.ticker + " " + timeframe.period + " | " + msg, alert.freq_once_per_bar_close)
// ====================================================================
//  7 · OLHC — CẤU TRÚC NẾN   (thứ duy nhất v4 thêm so với v3)
//  Cụm ĐỘC LẬP: chỉ đọc O/H/L/C của chính cây nến đang xét. Không đi qua
//  bộ lọc BIAS H1, không đọc state của JUDAS / TURTLE SOUP / CRB. Chỉ vẽ
//  trên nến ĐÃ ĐÓNG - nến đang chạy còn đổi số thì phân loại còn nhảy.
// ====================================================================
float olUw = high - math.max(open, close)
float olBd = math.abs(close - open)
float olLw = math.min(open, close) - low
float olRg = high - low

float olPu = olRg > 0.0 ? olUw / olRg * 100.0 : 0.0
float olPb = olRg > 0.0 ? olBd / olRg * 100.0 : 0.0
float olPl = olRg > 0.0 ? olLw / olRg * 100.0 : 0.0

float olAtrV   = ta.atr(olAtrLen)
bool  olStrong = not olAtrOn or (not na(olAtrV) and olRg >= olAtrV * olAtrMult)

bool olShBear = olPu >= olGap1 and olPb <= olGap2 and olPl <= olGap3
bool olShBull = olPl >= olGap1 and olPb <= olGap2 and olPu <= olGap3
bool olKBear  = not olUseK or olUw >= olK * olLw
bool olKBull  = not olUseK or olLw >= olK * olUw

// Ca hai cung dat thi bo - cay do khong nghieng han ve ben nao.
bool olOneSide = olRg > 0.0 and (olShBear or olShBull) and not (olShBear and olShBull)

bool olOhlcRaw = olOn and olOneSide and olShBear and olKBear and olStrong and barstate.isconfirmed
bool olOlhcRaw = olOn and olOneSide and olShBull and olKBull and olStrong and barstate.isconfirmed

// HAI CONG BIAS (26-08). OHLC = upper wick dai = tin hieu GIAM (-1);
// OLHC = lower wick dai = tin hieu TANG (+1). Phan TINH TOAN o tren khong bi
// dong toi mot dau cham nao — cong chi gac o day.
bool olOhlc = olOhlcRaw
bool olOlhc = olOlhcRaw

plotshape(olMark and olOhlc, "OLHC · OHLC tín hiệu GIẢM", shape.triangledown, location.abovebar, olColBear, size = size.tiny)
plotshape(olMark and olOlhc, "OLHC · OLHC tín hiệu TĂNG", shape.triangleup, location.belowbar, olColBull, size = size.tiny)
barcolor(olBar and olOhlc ? olColBear : (olBar and olOlhc ? olColBull : na), title = "OLHC · tô màu cả cây nến")

// Nhan la doi tuong ve nen xoa lai duoc -> cat theo o "so nhan giu lai".
var array<label> olPool = array.new<label>()

olTrim(pool, lb) =>
    array.push(pool, lb)
    while array.size(pool) > olKeep
        label.delete(array.shift(pool))

string olLbSize = olLbSz == "Nhỏ" ? size.small : olLbSz == "To" ? size.large : size.normal

if olLbl and (olOhlc or olOlhc)
    string olTip = (olOhlc ? "OHLC — TÍN HIỆU GIẢM" : "OLHC — TÍN HIỆU TĂNG") + "\nupper wick " + str.tostring(olUw, format.mintick) + "   " + str.tostring(olPu, "#.0") + "%" + "\nbody       " + str.tostring(olBd, format.mintick) + "   " + str.tostring(olPb, "#.0") + "%" + "\nlower wick " + str.tostring(olLw, format.mintick) + "   " + str.tostring(olPl, "#.0") + "%" + "\nrange      " + str.tostring(olRg, format.mintick) + "   ATR " + str.tostring(olAtrV, format.mintick)
    label olLb = label.new(bar_index, olOhlc ? high : low, olOhlc ? "OHLC" : "OLHC", style = olOhlc ? label.style_label_down : label.style_label_up, color = color.new(chart.bg_color, 15), textcolor = olOhlc ? olColBear : olColBull, size = olLbSize, tooltip = olTip)
    olTrim(olPool, olLb)

alertcondition(olOhlc, title = "OLHC · nến OHLC — tín hiệu GIẢM", message = "2TC-v10: nen OHLC - tin hieu giam")
alertcondition(olOlhc, title = "OLHC · nến OLHC — tín hiệu TĂNG", message = "2TC-v10: nen OLHC - tin hieu tang")

// =====================================================================
//  NHOM 13 — ĐƯỜNG HỒI QUY + PARABOL   (riêng bản v5, 25-08)
//
//  Bậc 1:  b = ( N*SUM(x*y) - SUM(x)*SUM(y) ) / ( N*SUM(x^2) - SUM(x)^2 )
//  Bậc 2:  y(x) = c + b*x + a*x^2, với x ĐẶT Ở TÂM cửa sổ nên SUM(x) = 0
//          và SUM(x^3) = 0 — hệ chuẩn tắc 3x3 rã thành hai mảnh rời,
//          không phải giải định thức, và ổn định số học hơn hẳn.
//
//  y'' = 2a = GIA TỐC — thứ đường thẳng không bao giờ thấy được.
//
//  Số điểm vẽ đường cong CHỐT Ở 31 (30 đoạn), đúng con số của bản MT5
//  và của Slope-Meter, để ba bản vẽ trùng khít.
// =====================================================================
sl_srcOf(s) =>
    s == "OPEN" ? open : s == "HIGH" ? high : s == "LOW" ? low : s == "MEDIAN" ? hl2 : s == "TYPICAL" ? hlc3 : s == "WEIGHTED" ? hlcc4 : close

sl_calc(N, sName, aLen, eOn, vMaLen, bMaLen) =>
    src = sl_srcOf(sName)
    sx  = N * (N - 1) / 2.0
    sxx = (N - 1) * N * (2.0 * N - 1) / 6.0
    den = N * sxx - sx * sx
    sy  = 0.0
    sxy = 0.0
    for k = 0 to N - 1
        y = src[N - 1 - k]
        sy  += y
        sxy += k * y
    b = den == 0.0 ? 0.0 : (N * sxy - sx * sy) / den
    a = (sy - b * sx) / N
    ybar = sy / N
    ssTot = 0.0
    ssRes = 0.0
    for k = 0 to N - 1
        y = src[N - 1 - k]
        r = y - (a + b * k)
        ssTot += (y - ybar) * (y - ybar)
        ssRes += r * r
    r2 = ssTot > 1e-12 ? math.max(0.0, 1.0 - ssRes / ssTot) : 0.0
    av = ta.atr(aLen)
    bn = av > 0.0 ? b / av : 0.0
    
    mass = 1.0
    ek = 0.0
    ep = 0.0
    mom = 0.0
    if eOn
        avgV = ta.sma(volume, N)
        avgMA = ta.sma(volume, vMaLen)
        mass := avgMA > 0 ? (avgV / avgMA) : 1.0
        if mass > 3.0
            mass := 3.0
        ek := 0.5 * mass * bn * math.abs(bn) * 100.0
        mom := mass * bn
        bMA = bMaLen <= 0 ? N : bMaLen
        avgBase = ta.sma(src, bMA)
        omega = bMA > 0 ? (2.0 * math.pi / bMA) : 1.0
        ycenter = a + b * (N - 1.0) / 2.0
        x = av > 0.0 ? (ycenter - avgBase) / av : 0.0
        ep := 0.5 * mass * math.pow(omega * x, 2) * 100.0

    [b, bn, r2, a, a + b * (N - 1), time[N - 1], time, mass, ek, ep, mom]

sl_curve(N, sName, aLen, pts) =>
    src = sl_srcOf(sName)
    dN  = N * 1.0
    S2  = (dN * dN * dN - dN) / 12.0
    S4  = dN * (dN * dN - 1.0) * (3.0 * dN * dN - 7.0) / 240.0
    den = dN * S4 - S2 * S2
    half = (dN - 1.0) / 2.0
    T0 = 0.0
    T1 = 0.0
    T2 = 0.0
    for k = 0 to N - 1
        x = k - half
        y = src[N - 1 - k]
        T0 += y
        T1 += x * y
        T2 += x * x * y
    b = S2 > 0.0 ? T1 / S2 : 0.0
    a = math.abs(den) > 1e-12 ? (dN * T2 - S2 * T0) / den : 0.0
    c = (T0 - S2 * a) / dN
    ybar = T0 / dN
    ssTot = 0.0
    ssRes = 0.0
    for k = 0 to N - 1
        x = k - half
        y = src[N - 1 - k]
        r = y - (c + b * x + a * x * x)
        ssTot += (y - ybar) * (y - ybar)
        ssRes += r * r
    r2 = ssTot > 1e-12 ? math.max(0.0, 1.0 - ssRes / ssTot) : 0.0
    av = ta.atr(aLen)
    accv = av > 0.0 ? 2.0 * a / av : 0.0
    sEnd = av > 0.0 ? (b + a * (dN - 1.0)) / av : 0.0
    P = math.min(N, pts)
    arrY = array.new<float>(0)
    arrT = array.new<int>(0)
    for i = 0 to P - 1
        kk = int(math.round(i * (N - 1) / (P - 1)))
        xx = kk - half
        array.push(arrY, c + b * xx + a * xx * xx)
        array.push(arrT, time[N - 1 - kk])
    [a, r2, accv, sEnd, arrY, arrT]

// Gọi vô điều kiện: Pine không cho gọi request.security trong nhánh if.
// Tắt enableSlope thì kết quả đơn giản là không được dùng vào đâu cả.
[slRaw, slNorm, slR2, slInt, slY1raw, slT0, slT1, slMass, slEk, slEp, slMom] = request.security(syminfo.tickerid, slTF, sl_calc(slLen, slSrc, slAtrLen, slEnergyOn, slVolMaLen, slBaseMaLen))
[slP2a, slP2r2, slAccV, slP2Slp, slP2Y, slP2T] = request.security(syminfo.tickerid, slTF, sl_curve(slLen, slSrc, slAtrLen, 31))

sl_styOf(s) =>
    s == "Nét đứt" ? line.style_dashed : s == "Chấm chấm" ? line.style_dotted : line.style_solid

slSegCol = na(slNorm) ? slColFlat : slNorm > slFlat ? slColUp : slNorm < -slFlat ? slColDn : slColFlat
slCurCol = slP2a >= 0.0 ? slP2Up : slP2Dn
slSegExt = slSegRay ? extend.right : extend.none
slNSeg   = 30

var line slSegLn = na
var array<line> slCurLn = array.new<line>(0)

if enableSlope and slSeg and not na(slRaw) and not na(slT0) and barstate.islast
    if na(slSegLn)
        slSegLn := line.new(slT0, slInt, slT1, slY1raw, xloc = xloc.bar_time)
    line.set_xy1(slSegLn, slT0, slInt)
    line.set_xy2(slSegLn, slT1, slY1raw)
    line.set_color(slSegLn, slSegCol)
    line.set_width(slSegLn, slSegW)
    line.set_style(slSegLn, sl_styOf(slSegSty))
    line.set_extend(slSegLn, slSegExt)

// 30 đoạn nối thành đường cong. Tạo MỘT LẦN rồi chỉ set toạ độ: line không
// rollback trên nến realtime nên tuyệt đối không tạo mới theo nến.
if enableSlope and slP2 and barstate.islast
    if array.size(slCurLn) == 0
        for i = 0 to slNSeg - 1
            array.push(slCurLn, line.new(time, close, time, close, xloc = xloc.bar_time))
    
    if array.size(slCurLn) > 0 and not na(slP2T)
        nSeg = array.size(slP2T) - 1
        for i = 0 to slNSeg - 1
            ln = array.get(slCurLn, i)
            if i < nSeg
                line.set_xy1(ln, array.get(slP2T, i), array.get(slP2Y, i))
                line.set_xy2(ln, array.get(slP2T, i + 1), array.get(slP2Y, i + 1))
                line.set_color(ln, slCurCol)
                line.set_width(ln, slP2W)
                line.set_style(ln, sl_styOf(slP2Sty))
            else
                line.set_color(ln, color.new(color.black, 100))

// =====================================================================
//  NHOM 14 — DASHBOARD
//
//  KẾT LUẬN xét ĐỦ BA THỨ chứ không mỗi độ dốc: đường cong khớp hơn hẳn
//  -> ĐANG CONG (đừng đọc độ dốc); cả hai không khớp -> GIÁ LOẠN; đường
//  thẳng khớp tốt -> mới đọc hướng, và còn so DỐC LÚC NÀY với ngưỡng đi
//  ngang để biết đà còn sức không.
// =====================================================================
db_posOf(s) =>
    s == "Trên · trái" ? position.top_left : s == "Dưới · phải" ? position.bottom_right : s == "Dưới · trái" ? position.bottom_left : position.top_right

db_sizeOf(s) =>
    s == "Tiny" ? size.tiny : s == "Small" ? size.small : s == "Large" ? size.large : size.normal

// Cú gần nhất của một cơ chế, dạng chuỗi để in ra bảng.
db_jdTxt() =>
    string s = "chưa có"
    if array.size(jdArr) > 0
        MechRec r = array.get(jdArr, array.size(jdArr) - 1)
        s := (r.dir == 1 ? "BUY" : "SELL") + (r.dead ? " hỏng" : r.done ? " xong" : " chờ")
    s

db_tsTxt() =>
    string s = "chưa có"
    if array.size(tsArr) > 0
        MechRec r = array.get(tsArr, array.size(tsArr) - 1)
        s := (r.dir == 1 ? "BUY" : "SELL") + (r.dead ? " hỏng" : r.done ? " xong" : " chờ")
    s

db_mechCol(txt) =>
    str.contains(txt, "hỏng") ? slColFlat : str.startswith(txt, "BUY") ? slColUp : str.startswith(txt, "SELL") ? slColDn : slColFlat

dbHaveP2 = enableSlope and not na(slP2a)
dbLoan   = na(slRaw) ? false : slR2 < slR2Min and (not dbHaveP2 or slP2r2 < slR2Min)
dbCong   = dbHaveP2 and slP2r2 >= slR2Min and (slP2r2 - slR2) >= slR2Gap

isUptrend = slNorm > 0
isBraking = dbHaveP2 and ((isUptrend and slAccV < 0) or (not isUptrend and slAccV > 0))
epDominates = math.abs(slEp) >= math.abs(slEk)
isP2Flip = dbHaveP2 and ((isUptrend and slP2Slp < 0) or (not isUptrend and slP2Slp > 0))

dbSta = "CHỜ NẾN"
dbStaDesc = "Chưa đủ dữ liệu nến"
dbStaAct = "Đứng ngoài chờ nến"
dbCol = slColFlat

if not na(slRaw)
    if dbLoan
        dbSta := "NHIỄU LOẠN"
        dbStaDesc := "Hành vi giá nhiễu loạn (Choppy)"
        dbStaAct := "Không giao dịch (No Trade Zone)"
        dbCol := slColFlat
    else if slR2 >= slR2Min and slEnergyOn and math.abs(slNorm) > slFlat
        if isBraking
            if epDominates
                if isP2Flip
                    dbSta := "ĐẢO CHIỀU XÁC NHẬN"
                    dbStaDesc := "Gia tốc đảo chiều. Cấu trúc giá thay đổi"
                    dbStaAct := "Tìm kiếm Entry đảo chiều (Reversal)"
                    dbCol := isUptrend ? slP2Dn : slP2Up
                else
                    dbSta := "KIỆT SỨC (CĂNG MAX)"
                    dbStaDesc := "Đà giá mở rộng quá mức (Overextended)"
                    dbStaAct := "Chuẩn bị kịch bản đảo chiều (Reversal)"
                    dbCol := color.orange
            else
                if isP2Flip
                    dbSta := "PULLBACK SÂU"
                    dbStaDesc := "Retracement sâu về Discount/Premium"
                    dbStaAct := "Tìm kiếm Entry thuận xu hướng"
                    dbCol := color.orange
                else
                    dbSta := "PULLBACK NHẸ"
                    dbStaDesc := "Nhịp hồi ngắn. Xung lượng chính vẫn mạnh"
                    dbStaAct := "Chốt lời ngắn. KHÔNG bắt đỉnh/đáy"
                    dbCol := isUptrend ? slColUp : slColDn
        else
            if not epDominates
                dbSta := "BÙNG NỔ THỰC SỰ"
                dbStaDesc := "Đột phá động lượng, Volume YẾU"
                dbStaAct := "Cảnh giác Fakeout/Stop Hunt. Scalp hoặc Nghỉ"
                dbCol := isUptrend ? slColUp : slColDn
            else
                if slMass > 1.5
                    dbSta := "QUÁN TÍNH (" + (isUptrend ? "TĂNG" : "GIẢM") + ")"
                    dbStaDesc := "Động lượng duy trì, Volume dồi dào"
                    dbStaAct := "Nắm giữ lệnh thuận xu hướng"
                    dbCol := isUptrend ? slColUp : slColDn
                else
                    dbSta := "TÍCH LŨY (NÉN)"
                    dbStaDesc := "Giá nén chặt trong biên độ hẹp (Consolidation)"
                    dbStaAct := "Chờ đợi Breakout xác nhận"
                    dbCol := color.new(#ff00ff, 0)
    else if dbCong
        dbSta := slP2a >= 0.0 ? "CHUYỂN HƯỚNG TĂNG" : "CHUYỂN HƯỚNG GIẢM"
        dbStaDesc := "Cấu trúc giá chuyển pha, chưa rõ xu hướng"
        dbStaAct := "Đứng ngoài quan sát"
        dbCol := slP2a >= 0.0 ? slP2Up : slP2Dn
    else if slR2 >= slR2Min and slNorm > slFlat
        dbSta := isBraking ? "KIỆT SỨC (TĂNG)" : "TĂNG"
        dbStaDesc := isBraking ? "Xung lượng Tăng suy yếu dần" : "Xu hướng Tăng ổn định"
        dbStaAct := isBraking ? "Canh chốt lời (Take Profit)" : "Follow Trend"
        dbCol := isBraking ? slP2Dn : slColUp
    else if slR2 >= slR2Min and slNorm < -slFlat
        dbSta := isBraking ? "KIỆT SỨC (GIẢM)" : "GIẢM"
        dbStaDesc := isBraking ? "Xung lượng Giảm suy yếu dần" : "Xu hướng Giảm ổn định"
        dbStaAct := isBraking ? "Canh chốt lời (Take Profit)" : "Follow Trend"
        dbCol := isBraking ? slP2Up : slColDn
    else
        dbSta := "TÍCH LŨY (NÉN)"
        dbStaDesc := "Giá đi ngang (Ranging)"
        dbStaAct := "Không giao dịch (No Trade Zone)"
        dbCol := slColFlat


dbJd  = db_jdTxt()
dbTs  = db_tsTxt()
// BIAS removed
// dbBh / dbBhC removed

dbR2C  = not na(slR2) and slR2 < slR2Min ? slColDn : dbColTx
dbR22C = not na(slP2r2) and slP2r2 < slR2Min ? slColDn : dbColTx
dbSlpC = na(slP2Slp) ? slColFlat : slP2Slp > slFlat ? slColUp : slP2Slp < -slFlat ? slColDn : slColFlat
dbAccC = na(slAccV) ? slColFlat : slAccV > 0.0 ? slP2Up : slAccV < 0.0 ? slP2Dn : slColFlat

dbTfTx = slTF == "" ? "chart" : slTF
dbVWin = dbTfTx + " x " + str.tostring(slLen)
dbVSlp = na(slNorm) ? "—" : str.tostring(slNorm, "+0.00;-0.00") + " ATR"
dbVRaw = na(slRaw) ? "—" : str.tostring(slRaw, format.mintick)
dbVR2  = na(slR2) ? "—" : str.tostring(slR2, "0.00")
dbVP2S = na(slP2Slp) ? "—" : str.tostring(slP2Slp, "+0.00;-0.00") + " ATR"
dbAccDir = na(slAccV) or na(slAccV[1]) ? "" : (math.abs(slAccV) > math.abs(slAccV[1]) ? " (Tăng)" : (math.abs(slAccV) < math.abs(slAccV[1]) ? " (Giảm)" : ""))
dbVAcc = na(slAccV) ? "—" : (na(slAccV[1]) ? str.tostring(slAccV, "+0.000;-0.000") : str.tostring(slAccV[1], "+0.000;-0.000") + " -> " + str.tostring(slAccV, "+0.000;-0.000")) + dbAccDir
dbVR22 = na(slP2r2) ? "—" : str.tostring(slP2r2, "0.00")

dbVMass = na(slMass) ? "—" : str.tostring(slMass, "0.00") + "x"
dbVMom  = na(slMom) ? "—" : str.tostring(slMom, "+0.00;-0.00")
dbVEk   = na(slEk) ? "—" : str.tostring(slEk, "0.00")
dbVEp   = na(slEp) ? "—" : str.tostring(slEp, "0.00")

dbRows = (dbMech ? 7 : 5)

var table dbTbl = na

if dbShow and barstate.islast
    if na(dbTbl)
        dbTbl := table.new(db_posOf(dbPos), 2, dbRows, bgcolor = dbColBg, border_width = 0)
    dbFz = db_sizeOf(dbFont)
    table.cell(dbTbl, 0, 0, "Đo trên", text_color = dbColTx, text_size = dbFz, text_halign = text.align_left)
    table.cell(dbTbl, 1, 0, dbVWin, text_color = dbColTx, text_size = dbFz, text_halign = text.align_right)
    
    table.cell(dbTbl, 0, 1, "Gia tốc", text_color = dbColTx, text_size = dbFz, text_halign = text.align_left)
    table.cell(dbTbl, 1, 1, dbVAcc, text_color = dbAccC, text_size = dbFz, text_halign = text.align_right)
    
    table.cell(dbTbl, 0, 2, "TÍN HIỆU", text_color = dbColTx, text_size = dbFz, text_halign = text.align_left)
    table.cell(dbTbl, 1, 2, dbSta, text_color = dbCol, text_size = dbFz, text_halign = text.align_right)
    
    table.cell(dbTbl, 0, 3, "TRẠNG THÁI", text_color = dbColTx, text_size = dbFz, text_halign = text.align_left)
    table.cell(dbTbl, 1, 3, dbStaDesc, text_color = dbColTx, text_size = dbFz, text_halign = text.align_right)
    
    table.cell(dbTbl, 0, 4, "ACTION", text_color = dbColTx, text_size = dbFz, text_halign = text.align_left)
    table.cell(dbTbl, 1, 4, dbStaAct, text_color = color.yellow, text_size = dbFz, text_halign = text.align_right)
    
    curr_row = 5
    if dbMech
        table.cell(dbTbl, 0, curr_row, "JUDAS", text_color = dbColTx, text_size = dbFz, text_halign = text.align_left)
        table.cell(dbTbl, 1, curr_row, dbJd, text_color = db_mechCol(dbJd), text_size = dbFz, text_halign = text.align_right)
        curr_row += 1
        table.cell(dbTbl, 0, curr_row, "T.SOUP", text_color = dbColTx, text_size = dbFz, text_halign = text.align_left)
        table.cell(dbTbl, 1, curr_row, dbTs, text_color = db_mechCol(dbTs), text_size = dbFz, text_halign = text.align_right)
        // BIAS row removed from dashboard


