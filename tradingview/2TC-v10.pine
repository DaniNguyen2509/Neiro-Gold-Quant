cisdW        = input.int(1, "", minval = 1, maxval = 5, inline = "k2", group = "5 · TURTLE SOUP — hiển thị")
cisdStyleVi  = input.string("Nét đứt", "", options = ["Nét đứt","Nét liền","Chấm chấm"], inline = "k2", group = "5 · TURTLE SOUP — hiển thị", tooltip = "Ba ô này CHỈ áp cho vạch CISD, hoàn toàn tách khỏi vạch MSS của Judas. Mặc định giống hệt vạch MSS (owner chốt 23-08: hai cơ chế phải cùng mặc định). Phân biệt hai vạch bằng MÀU và bằng chữ MSS / CISD.\n\nÔ DÀI để 0 (mặc định) = vạch TỰ DỪNG tại NẾN RA TÍN HIỆU. Cú còn sống thì mỗi nến vạch kéo thêm một cây; ra tín hiệu xong là thôi kéo, nên đầu phải của vạch dừng đúng chỗ mũi tên.\n\nĐể LỚN HƠN 0 = ép độ dài CỐ ĐỊNH bấy nhiêu nến kể từ NẾN NEO, không kéo theo giá nữa.\n\nCú nào hết cửa sổ mà vẫn chưa ra được tín hiệu thì bị bỏ, vạch CISD và chữ CISD XOÁ HẲN. Cửa sổ đó là ô iFVG — N nến từ cực trị sang TRÁI trong nhóm luật của Turtle Soup.")
cisdVis      = input.int (50, "Vạch CISD — độ RÕ khi chưa ra tín hiệu (%)", minval = 0, maxval = 100, group = "5 · TURTLE SOUP — hiển thị", tooltip = "MẶC ĐỊNH 50 = HIỆN MỜ (owner chốt 24-08 tối). Vạch và chữ vẽ ngay từ lúc máy CISD đẻ ra cú, mờ một nửa, rồi rõ 100% khi cú ra tín hiệu. Xem được cả cú ĐANG CHỜ lẫn cú HỎNG.\n\nSỐ CÀNG CAO CÀNG RÕ: 100 là rõ hẳn ngay từ đầu, số ở giữa là mờ mờ.\n\nDù để bao nhiêu, vạch vẫn có ĐÚNG HAI trạng thái — chưa qua vạch và đã qua vạch — phân biệt bằng bốn ô màu ở trên. Ô này là trục thứ hai, độc lập với bốn ô màu đó.\n\nHẠ VỀ 0 thì vạch không chỉ vô hình mà còn KHÔNG ĐƯỢC TẠO RA — nó sinh ra đúng khoảnh khắc cú ra tín hiệu. Khi đó số vạch trên chart LUÔN bằng số mũi tên, không có vạch nào đứng lẻ. Đánh đổi: không soi được cú đang chờ và cú hỏng nữa.")
cisdTxtGap   = input.float(0.3, "Vạch CISD — đẩy chữ (× ATR14)", minval = 0, maxval = 5, step = 0.05, group = "5 · TURTLE SOUP — hiển thị", tooltip = "Chữ CISD đặt ngay tại NẾN NEO CISD — cây sinh ra vạch đó — và luôn nằm NGOÀI thân nến, phía đối diện với hướng giá sắp đi:\n\n• Cú BÁN (nến cực trị là đỉnh): chữ nằm dưới ĐÁY nến neo, tức phía DƯỚI đường kẻ.\n• Cú MUA (nến cực trị là đáy): chữ nằm trên ĐỈNH nến neo, tức phía TRÊN đường kẻ.\n\nÔ này = nhô ra ngoài bao nhiêu lần ATR14. Để nhỏ hơn ô đẩy mũi tên thì chữ CISD không bao giờ ngang với mũi tên.")
tsAlert      = input.bool(true, "Alert khi có TS mới", group = "5 · TURTLE SOUP — hiển thị", tooltip = "Bắn alert() đúng MỘT lần mỗi khi đóng nến mà có tín hiệu Turtle Soup mới. Trong hộp thoại Alert của TradingView chọn Any alert() function call.\n\nÔ này tách riêng khỏi ô alert của Judas.")

