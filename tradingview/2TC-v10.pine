tsKeep       = input.int (20, "Giữ N cú gần nhất (kể cả cú hỏng)", minval = 1, maxval = 100, group = "5 · TURTLE SOUP — hiển thị", tooltip = "Cú Turtle Soup cũ hơn số này bị xoá khỏi chart cho nhẹ. Không ảnh hưởng gì tới luật, và không đụng tới Judas.\n\nÔ này đếm bằng HAI đơn vị, cố ý: N CÚ gần nhất còn giữ vạch CISD đang chờ, và N TÍN HIỆU gần nhất còn giữ mũi tên. Cú thì sinh dày hơn tín hiệu rất nhiều nên hai mốc lệch nhau xa — sửa 24-08: vạch của cú ĐÃ RA TÍN HIỆU nay sống đúng bằng tuổi thọ mũi tên của nó, không còn cảnh mũi tên trơ một mình.")
tsMarkVi     = input.string("Nến lấp iFVG", "Mũi tên — đặt tại", options = ["Nến lấp iFVG","Nến giữa iFVG","Nến cực trị"], group = "5 · TURTLE SOUP — hiển thị", tooltip = "Chỗ đặt mũi tên và chữ TS.\n\n• Nến lấp iFVG (mặc định) = cây nến CUỐI CÙNG lấp xong khe hở cũ, tức chỗ vào lệnh.\n• Nến giữa iFVG = cây thứ hai của bộ 3 nến tạo ra khe hở đó, nằm bên TRÁI nến cực trị.\n• Nến cực trị = đỉnh/đáy của đoạn CISD. Chọn mục này thì mũi tên về đúng cây cực trị, bất kể ô lọc swept đang bật hay tắt.\n\nHộp iFVG vẫn kéo từ chỗ khe hở sinh ra tới nến lấp dù chọn cái nào; vạch nối chấm chạy theo lựa chọn này. Judas có ô tương ứng trong nhóm hiển thị của nó.")
tsColBull    = input.color(#1E90FF, "Mũi tên — màu mua, bán", inline = "t1", group = "5 · TURTLE SOUP — hiển thị")
tsColBear    = input.color(#FF8C00, "",   inline = "t1", group = "5 · TURTLE SOUP — hiển thị", tooltip = "Màu của mũi tên, của chữ TS và của vạch nối chấm.")
tsGap        = input.float(1.8, "Mũi tên — đẩy xa nến, cỡ", minval = 0, maxval = 5, step = 0.05, inline = "t2", group = "5 · TURTLE SOUP — hiển thị")
tsTxSzVi     = input.string("Bình thường", "", options = ["Nhỏ","Bình thường","To"], inline = "t2", group = "5 · TURTLE SOUP — hiển thị", tooltip = "Ô đầu = đẩy mũi tên ra xa cây được đánh dấu bao nhiêu lần ATR14, MẶC ĐỊNH 1,80. Ô sau = cỡ chữ.\n\nPhải lớn hơn 0 thì mũi tên mới nhô hẳn ra NGOÀI hộp — để 0 là mũi tên nằm lọt trong hộp, nhìn không ra.\n\nCây được đánh dấu mà nằm trong bề ngang của hộp thì mốc đẩy là MÉP HỘP, không phải đỉnh/đáy cây nến — nhờ vậy mũi tên luôn thoát ra ngoài hộp.")
tsShowTxt    = input.bool(true, "Mũi tên — hiện chữ TS", group = "5 · TURTLE SOUP — hiển thị", tooltip = "Tắt đi thì chỉ còn mũi tên. Mũi tên thì luôn còn — nó chính là chỗ vào lệnh.")
tsStem       = input.bool(true, "Mũi tên — vạch nối xuống nến", group = "5 · TURTLE SOUP — hiển thị", tooltip = "Kẻ một vạch chấm nối từ mốc trên cây được đánh dấu lên tận mũi tên, để luôn biết mũi tên thuộc cây nào.\n\nChỉ có tác dụng khi ô đẩy mũi tên ở trên lớn hơn 0. Để 0 thì mũi tên nằm ngay trên nến rồi, không cần vạch nối.")
tsSigVis     = input.int(45, "Mũi tên — độ RÕ khi chưa qua vạch (%)", minval = 0, maxval = 100, group = "5 · TURTLE SOUP — hiển thị", tooltip = "MẶC ĐỊNH 45 = hiện mờ. Mũi tên của tín hiệu vừa ra lúc giá CHƯA đóng cửa xuyên qua vạch thì vẽ mờ theo ô này, và TỰ SÁNG lên 100% ngay khi vạch bị xuyên.\n\nSỐ CÀNG CAO CÀNG RÕ. Để 0 = giấu hẳn mũi tên cho tới khi vạch bị xuyên.\n\nTỪ 23-08 cuối hai ô bắt buộc có nến đóng cửa xuyên qua vạch MSS / CISD đều BẬT sẵn, nên tín hiệu chỉ ra SAU khi vạch bị xuyên — ô này chỉ còn tác dụng khi bạn tự tắt ô bắt buộc đó.")
tsBoxBull    = input.color(#FF8C00, "Hộp iFVG — màu FVG tăng lật, FVG giảm lật", inline = "tb1", group = "5 · TURTLE SOUP — hiển thị")
tsBoxBear    = input.color(#1E90FF, "",   inline = "tb1", group = "5 · TURTLE SOUP — hiển thị", tooltip = "Khe hở này ẨN suốt lúc theo dõi, không vẽ gì cả. CHỈ hiện ra đúng lúc nó BỊ LẤP, tức đúng lúc ra tín hiệu TS.\n\nHộp KÉO DÀI từ chỗ khe hở sinh ra tới đúng NẾN LẤP, nên nhìn phát là thấy nó sống được bao lâu.\n\nMàu đọc theo chiều của CHÍNH KHE HỞ vừa chết, kể chuyện bên nào vừa THẤT BẠI:\n\n• khe TĂNG bị lấp → CAM. Cú mua hỏng, nên đây là tín hiệu BÁN. Vạch CISD cũng cam.\n• khe GIẢM bị lấp → XANH DƯƠNG. Cú bán hỏng, nên đây là tín hiệu MUA. Vạch CISD cũng xanh dương.\n\nNgược với quy ước thường thấy, và đúng như vậy: màu ở đây nói về CÚ VỪA CHẾT chứ không phải cú sắp vào.\n\nViền để giống hệt hộp FVG tươi của Judas, chỉ khác màu.")
tsBoxW       = input.int(1, "Hộp iFVG — dày, nét, đậm viền, đậm nền (%)", minval = 1, maxval = 5, inline = "tb2", group = "5 · TURTLE SOUP — hiển thị")
tsBoxStyVi   = input.string("Nét liền", "", options = ["Nét liền","Nét đứt","Chấm chấm"], inline = "tb2", group = "5 · TURTLE SOUP — hiển thị")
tsBoxOp      = input.int(100, "", minval = 0, maxval = 100, inline = "tb2", group = "5 · TURTLE SOUP — hiển thị")
tsBoxFill    = input.int(12, "", minval = 0, maxval = 100, inline = "tb2", group = "5 · TURTLE SOUP — hiển thị", tooltip = "Bốn ô: độ dày viền, kiểu nét, độ đậm VIỀN, độ đậm NỀN.\n\nNền tô cùng màu với viền nhưng nhạt hơn hẳn, MẶC ĐỊNH 12 nên hộp CÓ nền mờ — hộp iFVG kéo dài từ chỗ khe sinh ra tới nến lấp nên có nền thì nhìn ra vùng đó ngay.\n\nĐể 0 là không tô nền. Độ dày 1 là mỏng nhất TradingView cho phép.")
cisdColBull  = input.color(#1E90FF, "Vạch CISD — màu ĐÃ qua: mua, bán", inline = "k1", group = "5 · TURTLE SOUP — hiển thị")
cisdColBear  = input.color(#FF8C00, "",   inline = "k1", group = "5 · TURTLE SOUP — hiển thị")
cisdColBullW = input.color(#90CAF9, "Vạch CISD — màu CHƯA qua: mua, bán", inline = "k3", group = "5 · TURTLE SOUP — hiển thị")
cisdColBearW = input.color(#FFCC80, "",   inline = "k3", group = "5 · TURTLE SOUP — hiển thị", tooltip = "Vạch CISD nằm tại GIÁ MỞ của nến neo CISD — cây tăng gần nhất khi đảo xuống, cây giảm gần nhất khi đảo lên.\n\nMặc định đặt theo đúng bộ màu của hộp iFVG: cú MUA (khe giảm chết) vạch XANH DƯƠNG, cú BÁN (khe tăng chết) vạch CAM. Nhìn màu là biết ngay bên nào vừa thất bại.\n\nBốn ô màu chạy y hệt vạch MSS nhưng hoàn toàn tách rời: chưa có nến nào đóng cửa xuyên qua thì dùng hai màu hàng dưới, xuyên rồi đổi lên hai màu hàng trên.")
