dgBw       = input.int(1, "Hộp FVG chẩn đoán — dày, nét, đậm viền (%)", minval = 1, maxval = 5, inline = "dg3", group = "6 · CHẨN ĐOÁN")
dgStyleVi  = input.string("Nét liền", "", options = ["Nét liền","Nét đứt","Chấm chấm"], inline = "dg3", group = "6 · CHẨN ĐOÁN")
dgOp       = input.int(70, "", minval = 0, maxval = 100, inline = "dg3", group = "6 · CHẨN ĐOÁN", tooltip = "Lớp này không tô nền, chỉ có viền. Để nhạt hơn hộp vào lệnh của hai cơ chế thì nhìn phát là biết cái nào là cái được chọn.")
showExtDot = input.bool(false, "Chấm nến cực trị — hiện, giữ N chấm", inline = "x0", group = "6 · CHẨN ĐOÁN", tooltip = "Chấm tròn bé xíu đặt tại đáy (cú mua) hoặc đỉnh (cú bán) của nến cực trị.\n\nĐây là lớp CHUNG của khúc gốc, không thuộc cơ chế nào — vẽ một lần cho mỗi nến cực trị, độ mờ cố định.")
extDotKeep = input.int(20, "", minval = 1, maxval = 200, inline = "x0", group = "6 · CHẨN ĐOÁN", tooltip = "Giữ bao nhiêu chấm gần nhất trên chart. Chấm cũ hơn số này bị xoá.")
extDotVi   = input.string("Chỉ nến cực trị có quét", "Chấm nến cực trị — chấm cây nào, màu", options = ["Chỉ nến cực trị có quét","Mọi nến cực trị CISD"], inline = "x1", group = "6 · CHẨN ĐOÁN", tooltip = "Chỉ nến cực trị có quét (mặc định) = chỉ chấm những nến cực trị đạt luật swept, bất kể hai ô lọc swept bên nhóm luật của Judas và Turtle Soup đang bật hay tắt.\n\nMọi nến cực trị CISD = chấm MỌI nến cực trị máy CISD chọn ra, kể cả cú bị ô lọc swept gạt đi. Đây là chế độ để trả lời câu hỏi vì sao đỉnh này không được xét: có chấm = máy CÓ xét nhưng cực trị không quét, không chấm = đỉnh đó nằm ngoài mọi đoạn CISD.")
